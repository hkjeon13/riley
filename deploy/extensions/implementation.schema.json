{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rustinfer.invalid/schemas/extension-implementation-v1.schema.json",
  "title": "rustinfer experimental extension implementation link",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "extension_id",
    "status",
    "proposal_path",
    "deploy_document_path",
    "benchmark_contract_path",
    "runtime_flag",
    "runtime_flag_source_path",
    "implementation_paths",
    "validation_tests",
    "default_enabled",
    "stable_default"
  ],
  "properties": {
    "$schema": {"const": "../implementation.schema.json"},
    "schema_version": {"const": "rustinfer.extension-implementation.v1"},
    "extension_id": {"$ref": "#/$defs/extensionId"},
    "status": {"const": "experimental-implementation"},
    "proposal_path": {
      "type": "string",
      "pattern": "^deploy/extensions/proposals/[a-z0-9][a-z0-9-]{1,62}[a-z0-9]\\.json$"
    },
    "deploy_document_path": {
      "type": "string",
      "pattern": "^deploy/extensions/plans/[a-z0-9][a-z0-9-]{1,62}[a-z0-9]\\.md$"
    },
    "benchmark_contract_path": {
      "type": "string",
      "pattern": "^benchmarks/extensions/contracts/[a-z0-9][a-z0-9-]{1,62}[a-z0-9]\\.json$"
    },
    "runtime_flag": {
      "type": "string",
      "pattern": "^RUSTINFER_EXPERIMENTAL_[A-Z0-9_]+$"
    },
    "runtime_flag_source_path": {"$ref": "#/$defs/repositoryPath"},
    "implementation_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/repositoryPath"}
    },
    "validation_tests": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/validationTest"}
    },
    "default_enabled": {"const": false},
    "stable_default": {"const": false}
  },
  "$defs": {
    "extensionId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,62}[a-z0-9]$"
    },
    "repositoryPath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*\\\\)(?!(?:.*/)?\\.{1,2}(?:/|$))(?!(?:.*/)?(?:\\.git|\\.gitignore|\\.gitattributes|\\.gitmodules|\\.mailmap)(?:/|$))[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "validationTest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "test_id"],
      "properties": {
        "path": {
          "type": "string",
          "pattern": "^crates/[A-Za-z0-9_-]+/tests/[A-Za-z0-9_][A-Za-z0-9_.-]*\\.rs$"
        },
        "sha256": {"$ref": "#/$defs/sha256"},
        "test_id": {
          "type": "string",
          "pattern": "^[a-z_][a-z0-9_]{0,127}$"
        }
      }
    }
  }
}
