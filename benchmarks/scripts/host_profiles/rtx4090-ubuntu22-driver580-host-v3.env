# Riley checked-in host profile.  This is declarative data, not shell code.
# preflight.sh accepts only these keys and records the profile ID/version beside
# every observed host field.  A profile revision is required for policy changes.
schema_version=riley.host-profile.v1
profile_id=rtx4090-ubuntu22-driver580-host-v3
profile_version=3
environment_ids=rtx4090-ubuntu22-driver580-v1,rtx4090-ubuntu22-driver580-20260911-v2
gpu_name=NVIDIA GeForce RTX 4090
compute_capability=8.9
memory_total_mib=24564
driver_version_prefix=580.
persistence_mode=Disabled
os_id=ubuntu
os_version_id=22.04
kernel_release=6.8.0-138-generic
machine=x86_64
cpu_model=Intel Core i7-13700K
cpu_model_substring=i7-13700K
physical_cpu_cores=16
logical_cpu_threads=24
cpu_governor=powersave
cpu_governor_policy_count=24
# One OS page has varied between observed boots.  16 MiB still rejects a
# materially smaller or larger host while avoiding a synthetic host identity.
ram_bytes_target=67185594368
ram_bytes_tolerance_bytes=16777216
# Desktop/display allocations are not CUDA compute work.  The separate empty
# compute-process check remains mandatory, while this bound covers observed
# 305--312 MiB idle use with bounded headroom.
max_idle_memory_mib=512
max_start_temperature_c=48
