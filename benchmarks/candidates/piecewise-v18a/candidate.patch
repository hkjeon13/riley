+ use super::prefill_piece_extent;
+ #[test]fn variable_prefix_and_multi_prefill(){
+  for r in 0..=32{for lengths in [vec![115],vec![120,125],vec![64,64,64],vec![130,130,130,130]]{
+   let mut slots=(0..r).collect::<Vec<u32>>();for(i,n)in lengths.iter().enumerate(){slots.extend(std::iter::repeat_n(r+i as u32,*n));}
+   assert_eq!(prefill_piece_extent(&slots,r as usize),Some((r as usize,lengths.iter().sum(),lengths.len()>1)));
+  }}
+ }
+ #[test]fn preserve_unmerged_and_partial_boundaries(){
+  for lengths in [vec![64,64],vec![63,120],vec![131],vec![130,130,130,130,64]]{
+   let mut slots=vec![];for(i,n)in lengths.iter().enumerate(){slots.extend(std::iter::repeat_n(i as u32,*n));}assert_eq!(prefill_piece_extent(&slots,0),None);
+  }
+  assert_eq!(prefill_piece_extent(&[0,0,1,1],1),None);assert_eq!(prefill_piece_extent(&[],0),None);
+ }
