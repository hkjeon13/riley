+// Mirrors the existing mode10 MLP merge contract, without changing arithmetic.
+// Two short groups whose sum is below161 retain their separate eager GEMMs.
+fn prefill_piece_extent(slots:&[u32],first:usize)->Option<(usize,usize,bool)>{
+ if first>=slots.len() || first>0 && slots[first-1]==slots[first]{return None;}
+ let mut at=first;let mut groups=0;
+ while at<slots.len(){let mut end=at+1;while end<slots.len()&&slots[end]==slots[at]{end+=1;}
+  if !(64..=130).contains(&(end-at)){return None;}groups+=1;at=end;
+ }
+ let rows=slots.len()-first;
+ if groups==1 || (161..=576).contains(&rows){Some((first,rows,groups>1))}else{None}
+}
