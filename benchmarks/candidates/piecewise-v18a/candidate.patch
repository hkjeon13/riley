+namespace {
+// Row offset is device data, so one exact-P piece serves every decode prefix.
+__global__ void piecewise_prefill_rows(const uint4* src,const uint32_t* first,uint4* dst,
+ uint64_t capacity,uint64_t rows,uint64_t width,bool scatter) {
+ const uint64_t start=first[0];if(start>capacity || rows>capacity-start)return;
+ for(uint64_t i=uint64_t(blockIdx.x)*blockDim.x+threadIdx.x;i<rows*width;i+=uint64_t(gridDim.x)*blockDim.x){
+  const uint64_t shifted=start*width+i;dst[scatter?shifted:i]=src[scatter?i:shifted];
+ }
+}
+} // namespace
