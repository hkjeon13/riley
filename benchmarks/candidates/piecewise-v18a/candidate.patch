+//! Exact prefill MLP pieces. Device row offsets remove decode R from graph keys.
+//! Each piece uses the same M and arithmetic selector as validated row groups.
+use crate::error::{CudaError,CudaResult};
+use crate::runtime::{CudaResourceIdentity,execution_stream_mut};
+use crate::{CudaContext,CudaDeviceBuffer,CudaPinnedHostBuffer,CudaBufferSpan,CudaBufferSpanMut,CudaDType,CudaExecutionStream,CudaStepGraph,CudaPreparedCublasGemmProbe,CudaGemmConfig,CublasGemmProbeParams,GatedMultiplyParams};
+use std::collections::HashMap;
+const OP:&str="prefill MLP piece";
+#[derive(Clone,Eq,PartialEq,Hash)]
+struct Binding(CudaResourceIdentity,u64,u64);
+#[derive(Eq,PartialEq,Hash)]
+struct Key{stream:CudaResourceIdentity,rows:u32,merged:bool,operands:[Binding;5]}
+/// Stable scratch shared across layers. All graphs retire before plans/scratch.
+/// Caller uploads the validated prefix once per batch, before any piece runs.
+pub struct CudaOwnedPrefillMlpGraph {
+ entries:HashMap<Key,CudaStepGraph>,gate_plan:CudaPreparedCublasGemmProbe,down_plan:CudaPreparedCublasGemmProbe,
+ input:CudaDeviceBuffer,output:CudaDeviceBuffer,gate:CudaDeviceBuffer,up:CudaDeviceBuffer,product:CudaDeviceBuffer,
+ prefix:CudaDeviceBuffer,prefix_host:CudaPinnedHostBuffer,capacity:u32,first:u32,
+ stream:Option<CudaResourceIdentity>,capture_allowed:bool,poisoned:bool,hits:u64,misses:u64,
+}
+impl CudaOwnedPrefillMlpGraph {
+ pub fn prepare(c:&CudaContext,capacity:u32)->CudaResult<Self>{
+  if !(128..=576).contains(&capacity){return Err(CudaError::invalid_argument(OP,"capacity128..576 required"));}
+  let mut gate_plan=c.prepare_owned_hf_gemm(CudaGemmConfig::new(capacity as u64,9728,2560,0)?)?;
+  let mut down_plan=c.prepare_owned_hf_gemm(CudaGemmConfig::new(capacity as u64,2560,9728,0)?)?;
+  gate_plan.prepare_sm80_prefill()?;down_plan.prepare_sm80_prefill()?;
+  let h=capacity as u64*2560*2;let m=capacity as u64*9728*2;
+  Ok(Self{entries:HashMap::new(),gate_plan,down_plan,input:c.allocate_device_buffer(h)?,output:c.allocate_device_buffer(h)?,gate:c.allocate_device_buffer(m)?,up:c.allocate_device_buffer(m)?,product:c.allocate_device_buffer(m)?,prefix:c.allocate_device_buffer(4)?,prefix_host:c.allocate_pinned_host_buffer(4)?,capacity,first:0,stream:None,capture_allowed:false,poisoned:false,hits:0,misses:0})
+ }
+ /// Called outside a command batch, after metadata validation.
+ pub fn stage_prefix(&mut self,first:u32)->CudaResult<()> {
+  if first>self.capacity{return Err(CudaError::invalid_argument(OP,"prefix exceeds capacity"));}
+  self.prefix_host.write(0,&first.to_ne_bytes())?;self.first=first;Ok(())
+ }
+ pub fn enqueue_prefix<S:CudaExecutionStream+?Sized>(&self,s:&mut S)->CudaResult<()>{self.prefix.copy_from_pinned_in_active_command_batch(0,&self.prefix_host,0,4,s)}
+ pub fn set_capture_allowed(&mut self,v:bool){self.capture_allowed=v;if !v{eprintln!("RILEY_PREFILL_PIECE_SEALED entries={}",self.entries.len());}}
+ pub fn execute<S:CudaExecutionStream+?Sized>(&mut self,input:CudaBufferSpan<'_>,gate:CudaBufferSpan<'_>,up:CudaBufferSpan<'_>,down:CudaBufferSpan<'_>,output:&mut CudaDeviceBuffer,rows:u32,merged:bool,s:&mut S)->CudaResult<()> {
+  if self.poisoned || rows>self.capacity-self.first || !(if merged{161..=576}else{64..=130}).contains(&rows){return Err(CudaError::invalid_argument(OP,"invalid exact piece extent or poisoned owner"));}
+  let s=execution_stream_mut(s);
+  if self.stream.as_ref().is_some_and(|v|*v!=s.identity){return Err(CudaError::invalid_state(OP,"piece owner cannot change streams"));}
+  self.stream=Some(s.identity.clone());
+  let b=|x:CudaBufferSpan<'_>|Binding(x.buffer().identity.clone(),x.byte_offset(),x.byte_len());
+  let out=CudaBufferSpan::new(output,CudaDType::BF16,0,self.capacity as u64*2560*2)?;
+  let key=Key{stream:s.identity.clone(),rows,merged,operands:[b(input),b(gate),b(up),b(down),b(out)]};
+  let prefix=CudaBufferSpan::new(&self.prefix,CudaDType::U32,0,4)?.raw();
+  let h=self.capacity as u64*2560*2;let m=self.capacity as u64*9728*2;
+  let raw=|x:&CudaDeviceBuffer,bytes|x.native_handle().span(crate::ffi::DTYPE_BF16,0,bytes);
+  self.gate_plan.register_mlp_uses(&self.down_plan,[raw(&self.input,h),gate.raw(),up.raw(),down.raw(),raw(&self.gate,m),raw(&self.up,m),raw(&self.product,m),raw(&self.output,h)],s)?;
+  crate::ffi::piecewise_rows_execute(input.raw(),prefix,raw(&self.input,h),self.capacity as u64,rows as u64,2560,2,&mut s.native)?;
+  crate::ffi::piecewise_rows_execute(raw(&self.output,h),prefix,out.raw(),self.capacity as u64,rows as u64,2560,3,&mut s.native)?;
+  if let Some(g)=self.entries.get(&key){
+   let result=crate::launch_step_graph(s,g);if result.is_err(){self.poisoned=true;}else{self.hits+=1;}return result;
+  }
+  self.misses+=1;
+  let work=|owner:&mut Self,s:&mut crate::CudaStream|->CudaResult<()> {
+   crate::ffi::piecewise_rows_execute(input.raw(),prefix,raw(&owner.input,h),owner.capacity as u64,rows as u64,2560,0,&mut s.native)?;
+   for (w,dst) in [(gate,&mut owner.gate),(up,&mut owner.up)] {
+    owner.gate_plan.execute_prefill_piece(&mut CublasGemmProbeParams{input:CudaBufferSpan::new(&owner.input,CudaDType::BF16,0,h)?,weight:w,output:CudaBufferSpanMut::new(dst,CudaDType::BF16,0,m)?},rows as u64,merged,s)?;
+   }
+   crate::silu_gated_multiply(&mut GatedMultiplyParams{activated_gate:CudaBufferSpan::new(&owner.gate,CudaDType::BF16,0,m)?,up:CudaBufferSpan::new(&owner.up,CudaDType::BF16,0,m)?,output:CudaBufferSpanMut::new(&mut owner.product,CudaDType::BF16,0,m)?,element_count:rows as u64*9728},s)?;
+   owner.down_plan.execute_prefill_piece(&mut CublasGemmProbeParams{input:CudaBufferSpan::new(&owner.product,CudaDType::BF16,0,m)?,weight:down,output:CudaBufferSpanMut::new(&mut owner.output,CudaDType::BF16,0,h)?},rows as u64,merged,s)?;
+   crate::ffi::piecewise_rows_execute(raw(&owner.output,h),prefix,out.raw(),owner.capacity as u64,rows as u64,2560,1,&mut s.native)
+  };
+  if let Err(e)=work(self,s){self.poisoned=true;return Err(e);}
+  if !self.capture_allowed || self.entries.len()>=18_432{return Ok(());}
+  crate::begin_step_capture(s)?;
+  if let Err(e)=work(self,s){let _=crate::abort_step_capture(s);self.poisoned=true;return Err(e);}
+  let graph=crate::end_step_capture(s)?;
+  if let Err(e)=crate::launch_step_graph(s,&graph){self.poisoned=true;return Err(e);}
+  self.entries.insert(key,graph);Ok(())
+ }
+ pub fn close(mut self)->CudaResult<()> {
+  eprintln!("RILEY_PREFILL_PIECE entries={} hits={} misses={}",self.entries.len(),self.hits,self.misses);
+  for(_,g)in self.entries.drain(){g.close()?;}
+  self.gate_plan.close()?;self.down_plan.close()?;
+  self.input.close()?;self.output.close()?;self.gate.close()?;self.up.close()?;self.product.close()?;self.prefix.close()?;self.prefix_host.close()
+ }
+}
