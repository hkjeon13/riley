+ for it in 0..40 {for tile in 0..304 {for row in 0..64 {let a=if row<32{&g}else{&u};let from=((tile*32+row%32)*2560+it*64)*2;let to=(((it*304+tile)*64+row)*64)*2;packed[to..to+128].copy_from_slice(&a[from..from+128]);}}}
+ let wg=upload(&c,&mut s,&mut h,&g)?;let wu=upload(&c,&mut s,&mut h,&u)?;
+ let wp=upload(&c,&mut s,&mut h,&packed)?;let input=upload(&c,&mut s,&mut h,&finite_bf16(16*2560,17))?;let mut out=c.allocate_device_buffer(16*9728*2)?;
