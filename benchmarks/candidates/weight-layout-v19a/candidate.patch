+  let mut gold=vec![0u8;(rows*9728*2)as usize];out.download_to_slice(0,&mut gold,&mut h,&mut s)?;
+  let stable=c.allocation_stats()?;
+  {let mut b=s.begin_command_batch()?;assert!(plan.try_execute_hf_sm80_fused_gate_up_packed(span(&wp)?,span(&wg)?,span(&wu)?,CudaBufferSpan::new(&input,CudaDType::BF16,0,rows*2560*2)?,CudaBufferSpanMut::new(&mut out,CudaDType::BF16,0,rows*9728*2)?,rows,&mut b.commands())?);b.finish()?;}
