+/// Copy only the fresh request's validated KV page ids into a fixed-size table.
+/// Decode reservations may have different lengths without changing this address.
+fn fixed_mixed_prefill_ids(offsets:&[u32],ids:&[u32],slot:usize,prefill:usize)
+    ->Option<[u8;super::owner::MIXED_PREFILL_TABLE_BYTES]> {
+    if !(65..=130).contains(&prefill){return None;}
+    let count=prefill.div_ceil(16);let start=*offsets.get(slot)? as usize;
+    let end=start.checked_add(count)?;
+    let declared_end=*offsets.get(slot.checked_add(1)?)? as usize;
+    if declared_end>ids.len() || end>declared_end{return None;}
+    let source=ids.get(start..end)?;
+    let mut bytes=[0;super::owner::MIXED_PREFILL_TABLE_BYTES];
+    for(chunk,id)in bytes.chunks_exact_mut(4).zip(source){chunk.copy_from_slice(&id.to_ne_bytes());}
+    Some(bytes)
+}
+#[cfg(test)]
+mod fixed_mixed_prefill_tests {
+    use super::fixed_mixed_prefill_ids;
+    #[test]
+    fn ragged_decode_reservations_do_not_change_the_fresh_prefill_table(){
+        let a=fixed_mixed_prefill_ids(&[0,1,3,12],&[41,42,43,17,3,29,5,31,7,37,11,13],2,130).unwrap();
+        let b=fixed_mixed_prefill_ids(&[0,4,7,16],&[91,92,93,94,95,96,97,17,3,29,5,31,7,37,11,13],2,130).unwrap();
+        assert_eq!(a,b);let expected:[u32;9]=[17,3,29,5,31,7,37,11,13];
+        for(word,id)in a.chunks_exact(4).zip(expected){assert_eq!(u32::from_ne_bytes(word.try_into().unwrap()),id);}
+    }
+    #[test]
+    fn truncated_or_invalid_tables_fail_before_any_copy(){
+        assert!(fixed_mixed_prefill_ids(&[0,2],&[1,2],0,130).is_none());
+        assert!(fixed_mixed_prefill_ids(&[0,9],&[1,2],0,130).is_none());
+        assert!(fixed_mixed_prefill_ids(&[0,99],&[1;9],0,130).is_none());
+        assert!(fixed_mixed_prefill_ids(&[0,9],&[1;9],0,131).is_none());
+        assert!(fixed_mixed_prefill_ids(&[0,9],&[1;9],usize::MAX,128).is_none());
+    }
