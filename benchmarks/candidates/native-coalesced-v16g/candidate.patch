+                        CudaBufferSpan::new(&input, CudaDType::BF16, 0, m * hidden * 2)?,
+                        CudaBufferSpan::new(&weights, CudaDType::BF16, 0, half * 2)?,
+                        CudaBufferSpanMut::new(&mut output, CudaDType::BF16, 0, m * intermediate * 4)?,
+                        m, &mut stream)?;
