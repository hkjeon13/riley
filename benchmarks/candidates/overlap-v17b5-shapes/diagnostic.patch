+// Diagnostic-only candidate: fixed host counters, emitted once at shutdown.
+// No CUDA arguments, scheduling, capture keys, or arithmetic are changed.
+pub(super) struct MixedGraphAudit {
+    total:u64, canonical:u64, hits:u64,
+    requests:[[u64;33];33], shapes:[[u64;131];32], shape_hits:[[u64;131];32], first_keys:[[u64;131];32], key_changes:[[u64;131];32],
+}
+impl MixedGraphAudit {
+    fn new()->Self{Self{total:0,canonical:0,hits:0,requests:[[0;33];33],shapes:[[0;131];32],shape_hits:[[0;131];32],first_keys:[[0;131];32],key_changes:[[0;131];32]}}
+    pub(super) fn record(&mut self,r:usize,p:usize,fresh:usize,canonical:bool,hit:bool,dense:usize,greedy:bool){
+        self.total+=1;self.canonical+=u64::from(canonical);self.hits+=u64::from(hit);
+        self.requests[r.min(32)][fresh.min(32)]+=1;
+        if fresh==1 && r<32 && p<131 {let key=((dense as u64)<<1)|u64::from(greedy);if self.shapes[r][p]==0{self.first_keys[r][p]=key;}else if self.first_keys[r][p]!=key{self.key_changes[r][p]+=1;}self.shapes[r][p]+=1;self.shape_hits[r][p]+=u64::from(hit);}
+    }
+}
+impl Drop for MixedGraphAudit {
+    fn drop(&mut self){
+        eprintln!("RILEY_MIXED_AUDIT total={} canonical={} key_hits={} canonical_key_misses={} scope=post-startup-whole-process",self.total,self.canonical,self.hits,self.canonical-self.hits);
