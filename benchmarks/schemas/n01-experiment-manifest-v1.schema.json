{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://riley.dev/schemas/n01-experiment-manifest-v1.schema.json",
  "title": "Riley N01 experiment lifecycle manifest v1",
  "description": "Offline benchmark-controller input. It does not describe or permit a Python serving runtime or Blender restoration.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "experiment_id",
    "lifecycle_policy",
    "contract_bindings",
    "target",
    "gpu",
    "memory_budget",
    "phases"
  ],
  "properties": {
    "schema_version": {
      "const": "riley.n01-experiment-manifest.v1"
    },
    "experiment_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "lifecycle_policy": {
      "const": "leave_stopped_no_restore"
    },
    "contract_bindings": {"$ref": "#/$defs/contractBindings"},
    "target": {"$ref": "#/$defs/target"},
    "gpu": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nvidia_smi", "gpu_indices", "poll_interval_ms"],
      "properties": {
        "nvidia_smi": {"type": "string", "minLength": 1},
        "gpu_indices": {"const": [0]},
        "poll_interval_ms": {"type": "integer", "minimum": 10, "maximum": 60000}
      }
    },
    "memory_budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["global_peak_ceiling_bytes", "uncertainty_reserve_bytes"],
      "properties": {
        "global_peak_ceiling_bytes": {"const": 20000000000},
        "uncertainty_reserve_bytes": {"const": 1000000000}
      }
    },
    "phases": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "prefixItems": [
        {"$ref": "#/$defs/assetPreparationPhase"},
        {"$ref": "#/$defs/gpuInitializationPhase"},
        {"$ref": "#/$defs/warmupPhase"},
        {"$ref": "#/$defs/timedServingPhase"},
        {"$ref": "#/$defs/shutdownPhase"}
      ],
      "items": false
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "sourceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "numericalProfileBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "sha256"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
        "path": {"type": "string", "minLength": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "checkpointProvenance": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status", "path", "sha256"],
          "properties": {
            "status": {"const": "materialized"},
            "path": {"type": "string", "minLength": 1},
            "sha256": {"$ref": "#/$defs/sha256"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": {
            "status": {"const": "materialization-pending"}
          }
        }
      ]
    },
    "contractBindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_descriptor", "numerical_profile", "checkpoint_provenance"],
      "properties": {
        "model_descriptor": {"$ref": "#/$defs/sourceBinding"},
        "numerical_profile": {"$ref": "#/$defs/numericalProfileBinding"},
        "checkpoint_provenance": {"$ref": "#/$defs/checkpointProvenance"}
      }
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_id", "evidence_scope"],
      "properties": {
        "model_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"},
        "evidence_scope": {"enum": ["operator-control", "full-model-serving"]}
      }
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "argv", "timeout_seconds"],
      "properties": {
        "name": {"type": "string"},
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
        "cwd": {"type": "string", "minLength": 1},
        "environment": {
          "type": "object",
          "propertyNames": {"pattern": "^[A-Za-z_][A-Za-z0-9_]*$"},
          "additionalProperties": {"type": "string"}
        }
      }
    },
    "assetPreparationPhase": {
      "allOf": [
        {"$ref": "#/$defs/phase"},
        {"properties": {"name": {"const": "asset-preparation"}}}
      ]
    },
    "gpuInitializationPhase": {
      "allOf": [
        {"$ref": "#/$defs/phase"},
        {"properties": {"name": {"const": "gpu-initialization"}}}
      ]
    },
    "warmupPhase": {
      "allOf": [
        {"$ref": "#/$defs/phase"},
        {"properties": {"name": {"const": "warmup"}}}
      ]
    },
    "timedServingPhase": {
      "allOf": [
        {"$ref": "#/$defs/phase"},
        {"properties": {"name": {"const": "timed-serving"}}}
      ]
    },
    "shutdownPhase": {
      "allOf": [
        {"$ref": "#/$defs/phase"},
        {"properties": {"name": {"const": "shutdown"}}}
      ]
    }
  }
}
