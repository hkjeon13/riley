{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rustinfer.dev/schemas/reliability-soak-run-v1.schema.json",
  "title": "rustinfer source-bound reliability soak run",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "manifest_sha256", "binding_sha256", "source", "target", "started_at_utc"],
  "properties": {
    "schema_version": {"const": "rustinfer.reliability-soak-run.v1"},
    "run_id": {"type": "string", "minLength": 1},
    "manifest_sha256": {"$ref": "#/$defs/sha256"},
    "binding_sha256": {"$ref": "#/$defs/sha256"},
    "started_at_utc": {"type": "string", "format": "date-time"},
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["git_commit", "git_dirty", "source_archive_sha256", "binary_sha256", "image_sha256", "model_sha256", "model_id", "model_revision"],
      "properties": {
        "git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$"},
        "git_dirty": {"const": false},
        "source_archive_sha256": {"$ref": "#/$defs/sha256"},
        "binary_sha256": {"$ref": "#/$defs/sha256"},
        "image_sha256": {"$ref": "#/$defs/sha256"},
        "model_sha256": {"$ref": "#/$defs/sha256"},
        "model_id": {"type": "string", "minLength": 1},
        "model_revision": {"type": "string", "minLength": 1}
      }
    },
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "pid", "image_id", "command_sha256"],
      "properties": {
        "kind": {"enum": ["process", "container"]},
        "pid": {"type": "integer", "minimum": 1},
        "image_id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "command_sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  },
  "$defs": {"sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
