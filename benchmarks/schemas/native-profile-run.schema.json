{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rustinfer.dev/schemas/native-profile-run-v1.schema.json",
  "title": "rustinfer native paired-profile run",
  "description": "One independent, Python-free native profiling run. Token identities are SHA-256 digests of exact u32 little-endian token byte streams; raw text and token IDs are forbidden by the closed request object.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "role",
    "pair_index",
    "run_id",
    "recorded_at_utc",
    "status",
    "failure_count",
    "source",
    "environment",
    "workload",
    "trace",
    "primary_metric",
    "aggregate",
    "requests"
  ],
  "properties": {
    "schema_version": { "const": "rustinfer.native-profile-run.v1" },
    "role": { "enum": ["baseline", "candidate"] },
    "pair_index": { "type": "integer", "minimum": 1, "maximum": 5 },
    "run_id": { "$ref": "#/$defs/id" },
    "recorded_at_utc": { "type": "string", "format": "date-time" },
    "status": { "enum": ["success", "failure"] },
    "failure_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 18446744073709551615
    },
    "source": { "$ref": "#/$defs/source" },
    "environment": { "$ref": "#/$defs/environment" },
    "workload": { "$ref": "#/$defs/workload" },
    "trace": { "$ref": "#/$defs/trace" },
    "primary_metric": { "$ref": "#/$defs/primaryMetric" },
    "aggregate": { "$ref": "#/$defs/aggregate" },
    "requests": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/request" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "gitCommit": { "type": "string", "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$" },
    "runtimeFlag": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "value"],
      "properties": {
        "name": { "$ref": "#/$defs/id" },
        "value": { "type": "string", "minLength": 1 }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "git_commit",
        "git_dirty",
        "executable_sha256",
        "implementation_id",
        "runtime_flag",
        "semantic_class",
        "correctness_gate_id",
        "correctness_report_sha256"
      ],
      "properties": {
        "git_commit": { "$ref": "#/$defs/gitCommit" },
        "git_dirty": { "type": "boolean" },
        "executable_sha256": { "$ref": "#/$defs/sha256" },
        "implementation_id": { "$ref": "#/$defs/id" },
        "runtime_flag": { "$ref": "#/$defs/runtimeFlag" },
        "semantic_class": { "const": "E0" },
        "correctness_gate_id": { "$ref": "#/$defs/id" },
        "correctness_report_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "gpu": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "uuid",
        "device_index",
        "pci_bus_id",
        "compute_capability",
        "vram_bytes"
      ],
      "properties": {
        "model": { "type": "string", "minLength": 1 },
        "uuid": { "type": "string", "minLength": 1 },
        "device_index": { "type": "integer", "minimum": 0 },
        "pci_bus_id": { "type": "string", "minLength": 1 },
        "compute_capability": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
        "vram_bytes": { "type": "integer", "minimum": 1 }
      }
    },
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "environment_id",
        "cpu_model",
        "physical_core_count",
        "logical_core_count",
        "ram_bytes",
        "os_release",
        "kernel_release",
        "architecture"
      ],
      "properties": {
        "environment_id": { "$ref": "#/$defs/id" },
        "cpu_model": { "type": "string", "minLength": 1 },
        "physical_core_count": { "type": "integer", "minimum": 1 },
        "logical_core_count": { "type": "integer", "minimum": 1 },
        "ram_bytes": { "type": "integer", "minimum": 1 },
        "os_release": { "type": "string", "minLength": 1 },
        "kernel_release": { "type": "string", "minLength": 1 },
        "architecture": { "type": "string", "minLength": 1 }
      }
    },
    "software": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nvidia_driver_version",
        "cuda_runtime_version",
        "cuda_toolkit_version",
        "cublas_version",
        "container_image_sha256"
      ],
      "properties": {
        "nvidia_driver_version": { "type": "string", "minLength": 1 },
        "cuda_runtime_version": { "type": "string", "minLength": 1 },
        "cuda_toolkit_version": { "type": "string", "minLength": 1 },
        "cublas_version": { "type": "string", "minLength": 1 },
        "container_image_sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gpu", "host", "software"],
      "properties": {
        "gpu": { "$ref": "#/$defs/gpu" },
        "host": { "$ref": "#/$defs/host" },
        "software": { "$ref": "#/$defs/software" }
      }
    },
    "workload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workload_id",
        "model_id",
        "model_revision",
        "weights_sha256",
        "tokenizer_sha256",
        "dtype",
        "concurrency",
        "prompt_tokens",
        "output_tokens",
        "warmups",
        "measured_iterations",
        "sampling_id",
        "seed"
      ],
      "properties": {
        "workload_id": { "$ref": "#/$defs/id" },
        "model_id": { "type": "string", "minLength": 1 },
        "model_revision": { "type": "string", "minLength": 1 },
        "weights_sha256": { "$ref": "#/$defs/sha256" },
        "tokenizer_sha256": { "$ref": "#/$defs/sha256" },
        "dtype": { "type": "string", "minLength": 1 },
        "concurrency": { "type": "integer", "minimum": 1, "maximum": 8 },
        "prompt_tokens": { "type": "integer", "minimum": 1, "maximum": 8192 },
        "output_tokens": { "type": "integer", "minimum": 2, "maximum": 512 },
        "warmups": { "type": "integer", "minimum": 5, "maximum": 100 },
        "measured_iterations": { "type": "integer", "minimum": 30, "maximum": 100 },
        "sampling_id": { "const": "greedy" },
        "seed": { "type": "null" }
      }
    },
    "trace": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capacity", "retained_records", "dropped_records"],
      "properties": {
        "capacity": {
          "type": "integer",
          "minimum": 1,
          "maximum": 18446744073709551615
        },
        "retained_records": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "dropped_records": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        }
      }
    },
    "primaryMetric": { "const": "aggregate.host.execute_ns" },
    "durationMeasurement": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["validity", "value"],
          "properties": {
            "validity": { "const": "measured" },
            "value": { "type": "number", "minimum": 0 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["validity", "value"],
          "properties": {
            "validity": { "const": "unmeasured" },
            "value": { "type": "null" }
          }
        }
      ]
    },
    "countMeasurement": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["validity", "value"],
          "properties": {
            "validity": { "const": "measured" },
            "value": {
              "type": "integer",
              "minimum": 0,
              "maximum": 18446744073709551615
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["validity", "value"],
          "properties": {
            "validity": { "const": "unmeasured" },
            "value": { "type": "null" }
          }
        }
      ]
    },
    "hostAggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan_ns", "execute_ns", "sampling_ns", "commit_ns"],
      "properties": {
        "plan_ns": { "$ref": "#/$defs/durationMeasurement" },
        "execute_ns": { "$ref": "#/$defs/durationMeasurement" },
        "sampling_ns": { "$ref": "#/$defs/durationMeasurement" },
        "commit_ns": { "$ref": "#/$defs/durationMeasurement" }
      }
    },
    "cudaAggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stream_span_ns", "idle_ns"],
      "properties": {
        "stream_span_ns": { "$ref": "#/$defs/durationMeasurement" },
        "idle_ns": { "$ref": "#/$defs/durationMeasurement" }
      }
    },
    "copyCounters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["h2d_calls", "h2d_bytes", "d2h_calls", "d2h_bytes"],
      "properties": {
        "h2d_calls": { "$ref": "#/$defs/countMeasurement" },
        "h2d_bytes": { "$ref": "#/$defs/countMeasurement" },
        "d2h_calls": { "$ref": "#/$defs/countMeasurement" },
        "d2h_bytes": { "$ref": "#/$defs/countMeasurement" }
      }
    },
    "allocationCounters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "device_allocations",
        "device_frees",
        "pinned_allocations",
        "pinned_frees",
        "peak_device_bytes"
      ],
      "properties": {
        "device_allocations": { "$ref": "#/$defs/countMeasurement" },
        "device_frees": { "$ref": "#/$defs/countMeasurement" },
        "pinned_allocations": { "$ref": "#/$defs/countMeasurement" },
        "pinned_frees": { "$ref": "#/$defs/countMeasurement" },
        "peak_device_bytes": { "$ref": "#/$defs/countMeasurement" }
      }
    },
    "counters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["iterations", "kernel_launches", "copies", "allocations"],
      "properties": {
        "iterations": { "$ref": "#/$defs/countMeasurement" },
        "kernel_launches": { "$ref": "#/$defs/countMeasurement" },
        "copies": { "$ref": "#/$defs/copyCounters" },
        "allocations": { "$ref": "#/$defs/allocationCounters" }
      }
    },
    "aggregate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "host",
        "cuda",
        "counters",
        "throughput_output_tokens_per_second"
      ],
      "properties": {
        "host": { "$ref": "#/$defs/hostAggregate" },
        "cuda": { "$ref": "#/$defs/cudaAggregate" },
        "counters": { "$ref": "#/$defs/counters" },
        "throughput_output_tokens_per_second": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_index",
        "prompt_u32le_sha256",
        "generated_u32le_sha256",
        "prompt_token_count",
        "requested_output_token_count",
        "generated_token_count",
        "ttft_ms",
        "tpot_ms",
        "e2e_ms"
      ],
      "properties": {
        "input_index": { "type": "integer", "minimum": 0 },
        "prompt_u32le_sha256": { "$ref": "#/$defs/sha256" },
        "generated_u32le_sha256": { "$ref": "#/$defs/sha256" },
        "prompt_token_count": { "type": "integer", "minimum": 1 },
        "requested_output_token_count": { "type": "integer", "minimum": 1 },
        "generated_token_count": {
          "type": "integer",
          "minimum": 1,
          "description": "Must equal requested_output_token_count; the standard JSON Schema cannot compare sibling values, so the v1 checker enforces this cross-field invariant."
        },
        "ttft_ms": { "type": "number", "minimum": 0 },
        "tpot_ms": { "type": "number", "minimum": 0 },
        "e2e_ms": { "type": "number", "minimum": 0 }
      }
    }
  }
}
