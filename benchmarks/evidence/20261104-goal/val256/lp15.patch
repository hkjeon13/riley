+const NO_NODE: u32 = u32::MAX;
+const NO_TOKEN: u32 = u32::MAX;
+
+/// One symbol of a piece being merged by token ID.
+#[derive(Clone, Copy)]
+struct IdNode {
+    id: u32,
+    previous: u32,
+    next: u32,
+    alive: bool,
+}
+
+type IdHeap = BinaryHeap<Reverse<(u32, u32, u32)>>;
+
+/// Buffers reused across the pieces of one input.
+#[derive(Default)]
+struct BpeWork {
+    nodes: Vec<IdNode>,
+    heap: IdHeap,
+}
