  --batch-token-budget N         tokens per CUDA iteration (default: 512)
  --prefill-chunk-tokens N       prompt tokens per request/iteration (default: 512)
  --prefill-plateau-rows LIST    ascending iteration sizes after which one more row costs a
                                 step-up (for example 128,192): an iteration that would end at
                                 most --prefill-plateau-defer-tokens past one runs the overflowing
                                 prompt tokens in the next iteration instead; a request waits at
                                 most once and its output does not change (default: off)
  --prefill-coalescing-tokens N  hold newly admitted prompts back until N prompt tokens are ready
                                 or the oldest has waited --prefill-coalescing-wait-us, so that
                                 several prompts start in one iteration; applies from
                                 --prefill-coalescing-min-decode-rows decode rows; a prompt's
                                 output does not change (default: off)
  --prefill-coalescing-wait-us N longest a ready prompt is held back (default: 10000)
  --prefill-coalescing-min-decode-rows N
                                 fewest decode rows for coalescing to apply (default: 4)
  --prefill-burst-steady-budget N
                                 iteration budget while more than --prefill-burst-max-decode-rows
                                 rows are decoding; with fewer, the whole --batch-token-budget is
                                 open to prompts, so a burst starts in fewer, larger steps; a
                                 prompt's output does not change (default: off)
  --prefill-burst-max-decode-rows N
                                 most decode rows at which the whole budget stays open (default: 8)
  --prefill-burst-max-decode-percent P
                                 the same bound as P percent of --max-active-sequences, rounded up
                                 (exclusive with --prefill-burst-max-decode-rows)
  --prefill-burst-min-prompt-tokens N
                                 open the whole budget only while a ready prompt has at least N
                                 tokens left, so short prompts arriving together keep the steady
                                 budget (default: 0, any prompt)
  --prefill-plateau-defer-tokens N
                                 largest overflow put off by --prefill-plateau-rows (default: 32)
  --prefill-plateau-min-decode-rows N
                                 fewest decode rows for --prefill-plateau-rows to apply
                                 (default: 12)
  --kv-blocks N                  physical 16-token KV blocks (default: full active promise)
  --prefix-cache-blocks N        keep up to N prompt KV blocks for requests that start with the
