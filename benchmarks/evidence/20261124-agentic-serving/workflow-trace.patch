+/// Diagnostic epoch shared by every trace event; intervals use a monotonic clock.
+pub(crate) fn workflow_clock() -> u128 {
+    use std::sync::OnceLock;
+    use std::time::{Instant, SystemTime, UNIX_EPOCH};
+    static ORIGIN: OnceLock<(Instant, u128)> = OnceLock::new();
+    let (clock, epoch) = ORIGIN.get_or_init(|| (Instant::now(), SystemTime::now().duration_since(UNIX_EPOCH).unwrap().as_nanos()));
+    epoch + clock.elapsed().as_nanos()
+}
 
