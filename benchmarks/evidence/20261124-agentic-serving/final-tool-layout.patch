     #[test]
+    fn final_turn_can_keep_tool_descriptions_without_enabling_calls() {
+        let mut body = json!({"model":"m", "tools":weather(), "tool_choice":"none",
+            "messages":[{"role":"user","content":"Summarize the report."}]});
+        let tmpl = template(TOOLS);
+        let hidden = normalize_chat_request(request(body.clone()), &tmpl, limits()).unwrap();
+        body["include_tools_when_tool_choice_none"] = json!(true);
+        let parsed = request(body.clone());
+        assert_eq!(tmpl.tool_parsing(&parsed), None);
+        let kept = normalize_chat_request(parsed, &tmpl, limits()).unwrap();
+        assert!(kept.grammar.is_none());
+        assert_ne!(kept.prompt, hidden.prompt);
+        body["tool_choice"] = json!("auto");
+        let offered = normalize_chat_request(request(body.clone()), &tmpl, limits()).unwrap();
+        assert_eq!(kept.prompt, offered.prompt);
+        body["tool_choice"] = json!("none");
+        body["tools"] = json!([{"type":"function","function":{}}]);
+        assert!(normalize_chat_request(request(body), &tmpl, limits()).is_err());
+    }
