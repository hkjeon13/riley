+// Diagnostic patch only. A single resolved final prefill row is copied into
+// the ordinary pinned I/O buffer, whose contents are read after command completion.
+struct LongTrace {
+    directory: PathBuf,
+    position: u32,
+    token_id: u32,
+    row: usize,
+    active_rows: usize,
+    dense_rows: usize,
+    end: u64,
+    entries: Vec<(&'static str, Option<usize>, u64, u64)>,
+}
+
+fn long_trace_error() -> LlamaBatchExecutorError {
+    LlamaBatchExecutorError::InvalidConfiguration {
+        field: "W4 final prefill trace",
+        reason: "expected a single selected prefill row, an empty output directory, and a synchronous metadata command batch",
+    }
 }
 
+impl LongTrace {
+    fn select(
+        packed: LlamaPackedBatchMetadata<'_>,
+        dense_rows: usize,
+        config: PreparedLlamaBatchExecutorConfig,
+        tensor_parallel: bool,
+    ) -> LlamaBatchExecutorResult<Option<Self>> {
+        let Some(directory) = std::env::var_os("RILEY_REGISTER_LAYER_TRACE") else {
+            return Ok(None);
+        };
+        let [row] = packed.output_token_indices() else {
+            return Ok(None);
+        };
+        let [sequence] = packed.output_row_indices() else {
+            return Ok(None);
+        };
+        let row = *row as usize;
+        let position = packed.position_ids()[row];
+        let token_id = packed.input_token_ids()[row];
+        let kind = packed.row_kind_codes()[*sequence as usize];
+        let target = match (position, token_id) {
+            (5987, _) if kind == LlamaBatchRowKind::Prefill.code() => "lookup-541-prefill",
+            (5991, 515) if kind == LlamaBatchRowKind::Decode.code() => "lookup-541-decode",
+            (25027, _) if kind == LlamaBatchRowKind::Prefill.code() => "lookup-862-prefill",
+            (25058, 15) if kind == LlamaBatchRowKind::Decode.code() => "lookup-862-decode",
+            _ => return Ok(None),
+        };
+        let active_rows = packed.total_input_tokens();
+        if tensor_parallel
+            || packed.row_kind_codes().len() != 1
+            || config.execution_completion_implementation()
+                != ExecutionCompletionImplementation::IterationBatch
+            || config.metadata_transport() != BatchMetadataTransport::Synchronous
+        {
+            return Err(long_trace_error());
+        }
+        let directory = PathBuf::from(directory).join(target);
+        if !directory.is_absolute() || !directory.is_dir() || directory.join("index.tsv").exists() {
+            return Err(long_trace_error());
+        }
+        Ok(Some(Self {
+            directory,
+            position,
+            token_id,
+            row,
+            active_rows,
+            dense_rows,
+            end: 0,
+            entries: Vec::with_capacity(385),
+        }))
+    }
+
+    fn save(self, staging: &mut CudaPinnedHostBuffer) -> LlamaBatchExecutorResult<()> {
+        let mut bytes = vec![0_u8; self.end as usize];
+        staging
+            .read(0, &mut bytes)
+            .map_err(|source| batch_cuda(ExecutionSite::global(LlamaOp::OutputGather), source))?;
+        self.write(&bytes).map_err(|error| {
+            eprintln!("W4 trace output failed: {error}");
+            long_trace_error()
+        })
+    }
+
+    fn write(&self, bytes: &[u8]) -> std::io::Result<()> {
+        let mut payload = std::fs::OpenOptions::new()
+            .write(true)
+            .create_new(true)
+            .open(self.directory.join("rows.bf16"))?;
+        payload.write_all(bytes)?;
+        let mut index = std::fs::OpenOptions::new()
+            .write(true)
+            .create_new(true)
+            .open(self.directory.join("index.tsv"))?;
+        writeln!(
+            index,
+            "# {} {} {} {} {}",
+            self.position, self.token_id, self.row, self.active_rows, self.dense_rows
+        )?;
+        for (stage, layer, offset, count) in &self.entries {
+            let layer = layer.map_or_else(|| "-".to_owned(), |number| number.to_string());
+            writeln!(index, "{stage}\t{layer}\t{offset}\t{count}")?;
+        }
+        Ok(())
+    }
+}
+
+fn trace_row<S: CudaExecutionStream + ?Sized>(
+    trace: &mut Option<(&mut LongTrace, &CudaPinnedHostBuffer)>,
+    stage: &'static str,
+    layer: Option<usize>,
+    buffer: &CudaDeviceBuffer,
+    width: u64,
+    gathered: bool,
+    stream: &mut S,
+) -> LlamaBatchExecutorResult<()> {
+    if !matches!(
+        stage,
+        "embedding"
+            | "input_norm"
+            | "query_rope"
+            | "attention_context"
+            | "attention_projection"
+            | "layer_residual"
+            | "final_norm"
+            | "logits"
+    ) {
+        return Ok(());
+    }
+    if let Some((trace, staging)) = trace {
+        let row = if gathered { 0 } else { trace.row as u64 };
+        let bytes = width * 2;
+        let offset = trace.end;
+        if offset + bytes > staging.byte_len() {
+            return Err(long_trace_error());
+        }
+        buffer
+            .copy_to_pinned_in_active_command_batch(row * bytes, staging, offset, bytes, stream)
+            .map_err(|source| batch_cuda(ExecutionSite::global(LlamaOp::OutputGather), source))?;
+        trace.entries.push((stage, layer, offset, bytes));
+        trace.end += bytes;
+    }
+    Ok(())
+}
