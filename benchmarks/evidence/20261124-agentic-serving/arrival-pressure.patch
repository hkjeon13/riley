+// The iterator contains currently live, long requests only. Admission
+// iterations can be unordered because the request table reuses slots.
+fn clustered_long_requests(iterations: impl Iterator<Item = u64> + Clone) -> bool {
+    iterations.clone().any(|first| {
+        iterations
+            .clone()
+            .filter(|&step| step == first || step.checked_sub(1) == Some(first))
+            .nth(3)
+            .is_some()
+    })
+}
