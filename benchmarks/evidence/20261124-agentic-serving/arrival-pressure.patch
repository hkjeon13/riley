+    #[test]
+    fn admission_order_preserves_decode_and_keeps_an_incomplete_long_prompt_first() {
+        use crate::{IterationPlan, PrefillBurstPolicy, WorkItem};
+
+        fn plan(scheduler: &mut Scheduler, now: u64) -> IterationPlan {
+            scheduler
+                .plan_iteration(now)
+                .unwrap()
+                .into_parts()
+                .0
+                .unwrap()
+        }
+
+        fn settle(scheduler: &mut Scheduler, plan: &IterationPlan, now: u64) {
+            let outputs = plan
+                .prefill_items()
+                .iter()
+                .chain(plan.decode_items())
+                .filter_map(WorkItem::output_slot)
+                .map(|slot| IterationOutput::new(slot, 7, false))
+                .collect();
+            let result = IterationResult::new(plan.iteration_id(), outputs, 1, 0).unwrap();
+            scheduler.complete_iteration(&result, now).unwrap();
+        }
+
+        for (enabled, second_length, atomic, step_time, expect_earliest, expect_decode_rows) in [
+            (false, 6, false, 5, false, 2),
+            (true, 6, false, 5, true, 2),
+            (false, 6, false, 15, false, 1),
+            (true, 6, false, 15, true, 2),
+            (true, 2, false, 5, false, 2),
+            (true, 2, false, 15, false, 2),
+            (true, 6, true, 5, false, 2),
+        ] {
+            let mut scheduler = test_scheduler_with_max_active_sequences(4);
+            scheduler.diagnostic_admission_order = enabled;
+            scheduler
+                .set_prefill_burst_policy(Some(PrefillBurstPolicy {
+                    steady_budget: 3,
+                    max_decode_rows: 2,
+                    min_prompt_tokens: 4,
+                }))
+                .unwrap();
+            let first_decode = scheduler
+                .submit(RequestDescriptor::new(vec![3], 8), 0)
+                .unwrap();
+            let second_decode = scheduler
+                .submit(RequestDescriptor::new(vec![4], 8), 0)
+                .unwrap();
+            let starting = plan(&mut scheduler, 0);
+            settle(&mut scheduler, &starting, 1);
+
+            let earliest = scheduler
+                .submit(RequestDescriptor::new(vec![5; 8], 2), 2)
+                .unwrap();
+            let partial = plan(&mut scheduler, 2);
+            assert_eq!(
+                partial.prefill_items()[0].request_id(),
+                earliest.request_id()
+            );
+            let later = scheduler
+                .submit(RequestDescriptor::new(vec![6; second_length], 2), 3)
+                .unwrap();
+            settle(&mut scheduler, &partial, 4);
+            scheduler.atomic_prefill_chunks = atomic;
+
+            let next = plan(&mut scheduler, step_time);
+            assert_eq!(next.decode_items().len(), expect_decode_rows);
+            assert_eq!(
+                next.decode_items()[0].request_id(),
+                first_decode.request_id()
+            );
+            if expect_decode_rows == 2 {
+                assert_eq!(
+                    next.decode_items()[1].request_id(),
+                    second_decode.request_id()
+                );
+            }
+            if atomic {
+                assert!(next.prefill_items().is_empty());
+            } else {
+                let expected = if expect_earliest { earliest } else { later };
+                assert_eq!(next.prefill_items()[0].request_id(), expected.request_id());
+            }
+        }
+    }
+
+    #[test]
+    fn two_long_prompts_keep_admission_order_across_chunks() {
+        use crate::{PrefillBurstPolicy, WorkItem};
+
+        for initially_waiting in [false, true] {
+            let max_active = if initially_waiting { 2 } else { 4 };
+            let mut scheduler = test_scheduler_with_max_active_sequences(max_active);
+            scheduler.diagnostic_admission_order = true;
+            scheduler
+                .set_prefill_burst_policy(Some(PrefillBurstPolicy {
+                    steady_budget: 3,
+                    max_decode_rows: 2,
+                    min_prompt_tokens: 4,
+                }))
+                .unwrap();
+            for token in [3, 4] {
+                scheduler
+                    .submit(RequestDescriptor::new(vec![token], 1), 0)
+                    .unwrap();
+            }
+            let starting = scheduler.plan_iteration(0).unwrap().into_parts().0.unwrap();
+            let earliest = scheduler
+                .submit(RequestDescriptor::new(vec![5; 8], 2), 1)
+                .unwrap();
+            let later = scheduler
+                .submit(RequestDescriptor::new(vec![6; 6], 2), 2)
+                .unwrap();
+            assert_eq!(
+                earliest.state(),
+                if initially_waiting {
+                    RequestState::Waiting
+                } else {
+                    RequestState::Admitted
+                }
+            );
+            assert_eq!(later.state(), earliest.state());
+            let outputs = starting
+                .prefill_items()
+                .iter()
+                .filter_map(WorkItem::output_slot)
+                .map(|slot| IterationOutput::new(slot, 7, false))
+                .collect();
+            let result = IterationResult::new(starting.iteration_id(), outputs, 1, 0).unwrap();
+            scheduler.complete_iteration(&result, 3).unwrap();
+
+            let first = scheduler.plan_iteration(3).unwrap().into_parts().0.unwrap();
+            assert_eq!(first.prefill_items()[0].request_id(), earliest.request_id());
+            let admission_iteration =
+                |id| scheduler.requests[scheduler.record_index(id).unwrap()].admission_iteration;
+            assert_eq!(
+                admission_iteration(earliest.request_id()),
+                admission_iteration(later.request_id())
+            );
+            let result = IterationResult::new(first.iteration_id(), vec![], 1, 0).unwrap();
+            scheduler.complete_iteration(&result, 4).unwrap();
+
+            let next = scheduler.plan_iteration(5).unwrap().into_parts().0.unwrap();
+            assert_eq!(next.prefill_items()[0].request_id(), earliest.request_id());
+        }
+    }
+
+    #[test]
+    fn cluster_requires_four_live_requests_in_two_adjacent_iterations() {
+        for (steps, expected) in [
+            (vec![9, 8, 9, 8], true),
+            (vec![5, 5, 5, 5], true),
+            (vec![8, 8, 9], false),
+            (vec![8, 9, 9, 10], false),
+            (vec![0, u64::MAX, 0, u64::MAX], false),
+        ] {
+            assert_eq!(super::clustered_long_requests(steps.into_iter()), expected);
+        }
+    }
