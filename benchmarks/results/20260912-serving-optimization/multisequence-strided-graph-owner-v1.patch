+                input.as_ptr(),
+                weight.as_ptr(),
+                output.as_ptr(),
+                workspace.map_or(ptr::null_mut(), DeviceBufferHandle::as_ptr),
+                mode,
+                &mut capture,
+                &mut graph_error,
+                &mut error,
+            )
+        };
