+#[test]
+fn execution_authority_rejects_forged_tokens_and_stale_plan() {
+    use riley_scheduler::WorkItem;
+    let mut s = scheduler(4);
+    submit(&mut s, 17, 32, 0);
+    let p = plan(&mut s, 1);
+    let original = &p.prefill_items()[0];
+    let changed = WorkItem::new(
+        original.request_id(),
+        original.kind(),
+        vec![18; 128],
+        original.target_logical_length(),
+        original.block_table_index(),
+        original.output_slot(),
+    )
+    .unwrap();
+    let forged = IterationPlan::new(
+        p.iteration_id(),
+        vec![changed],
+        vec![],
+        p.block_tables().to_vec(),
+    )
+    .unwrap();
+    assert!(s.authorize_execution(&forged).is_err());
+    {
+        let authority = s.authorize_execution(&p).unwrap();
+        assert_eq!(authority.plan(), &p);
+        assert_eq!(authority.physical_block_count(), 40);
+        assert_eq!(authority.rows()[0].committed_length(), 0);
+        assert_eq!(authority.rows()[0].generated_index(), 0);
+        assert_eq!(authority.rows()[0].max_output_tokens(), 32);
+        assert_eq!(authority.block_owners().len(), 8);
+    }
+    complete(&mut s, &p, 2);
+    assert!(s.authorize_execution(&p).is_err());
+    close(s, 3);
+}
