+#[test]
+fn execution_authority_checks_actual_tables_and_off_batch_owners() {
+    use riley_scheduler::OwnedBlockTable;
+    let mut s = scheduler(4);
+    let first = submit(&mut s, 17, 32, 0);
+    let second = submit(&mut s, 19, 32, 0);
+    let p = plan(&mut s, 1);
+    let table = &p.block_tables()[0];
+    let mut ids = table.physical_block_ids().to_vec();
+    ids[0] = 39;
+    let changed = OwnedBlockTable::new(
+        table.request_id(),
+        table.version(),
+        ids,
+        table.valid_tokens().to_vec(),
+        table.logical_length(),
+    )
+    .unwrap();
+    let forged = IterationPlan::new(
+        p.iteration_id(),
+        p.prefill_items().to_vec(),
+        vec![],
+        vec![changed],
+    )
+    .unwrap();
+    assert!(s.authorize_execution(&forged).is_err());
+    complete(&mut s, &p, 2);
+    let mut observed = false;
+    for now in 3..8 {
+        let p = plan(&mut s, now);
+        let authority = s.authorize_execution(&p).unwrap();
+        if p.prefill_items()
+            .first()
+            .is_some_and(|w| w.request_id() == second)
+        {
+            assert!(
+                authority
+                    .block_owners()
+                    .iter()
+                    .any(|(_, owner)| *owner == first)
+            );
+            assert!(
+                authority
+                    .block_owners()
+                    .iter()
+                    .any(|(_, owner)| *owner == second)
+            );
+            observed = true;
+        }
+        drop(authority);
+        complete(&mut s, &p, now);
+    }
+    assert!(observed);
+    close(s, 10);
+}
