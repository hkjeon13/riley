+int main(){kernel_batch05_matrix_main();int decode=0,mapped=0;for(int seed:{1,17,99}){decode+=decode_values_cases(seed);mapped+=mapped_values_cases(seed);}OK(cudaDeviceSynchronize());std::printf("{\"passed\":true,\"cases\":%d,\"decode_value_cases\":%d,\"mapped_value_cases\":%d,\"BF16_and_FP32_exact\":true,\"performance_claim_eligible\":false}\n",1208+decode+mapped,decode,mapped);return 0;}
