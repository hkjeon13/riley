+  for(int i=0;i<Guard;++i)if(__bfloat16_as_ushort(b[i])!=0x4123||__bfloat16_as_ushort(b[Guard+N+i])!=0x4123)std::exit(4);
+  for(int i=total*576;i<N;++i)if(__bfloat16_as_ushort(b[Guard+i])!=0x4123)std::exit(4);
