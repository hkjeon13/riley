+// Pinned PyTorch Reduce.cuh selects block=(512,1) for a single contiguous
+// 2048-wide FP32 mean: one float4 per thread, shared reductions at
+// 256/128/64/32, then decreasing warp shuffles. Prefill uses (32,16)
+// and its independently qualified kernel remains unchanged.
+__global__ __launch_bounds__(512)
+void hugging_face_qwen_singleton_rms_norm_kernel(
+    const __nv_bfloat16* input, const __nv_bfloat16* weight,
+    __nv_bfloat16* output, float epsilon) {
+  const uint32_t thread = threadIdx.x;
+  const uint32_t first = thread * 4;
+  float sum = 0.0F;
+  #pragma unroll
+  for (uint32_t element = 0; element < 4; ++element) {
+    const float value = __bfloat162float(input[first + element]);
+    sum = __fadd_rn(sum, __fmul_rn(value, value));
+  }
+  __shared__ float partials[512];
+  __shared__ float inverse_rms;
+  partials[thread] = sum;
+  for (uint32_t offset = 256; offset >= 32; offset /= 2) {
+    __syncthreads();
+    if (thread < offset) {
+      sum = __fadd_rn(sum, partials[thread + offset]);
+      partials[thread] = sum;
+    }
+  }
+  __syncthreads();
+  if (thread < 32) {
+    for (uint32_t offset = 16; offset != 0; offset /= 2) {
+      sum = __fadd_rn(sum, __shfl_down_sync(0xffff'ffffU, sum, offset));
+    }
+    if (thread == 0) {
+      const float variance = __fmul_rn(sum, 1.0F / 2048.0F);
+      inverse_rms = rsqrtf(__fadd_rn(variance, epsilon));
+    }
+  }
+  __syncthreads();
+  #pragma unroll
+  for (uint32_t element = 0; element < 4; ++element) {
+    const uint32_t column = first + element;
+    const float normalized =
+        __fmul_rn(__bfloat162float(input[column]), inverse_rms);
+    const __nv_bfloat16 normalized_bf16 = __float2bfloat16_rn(normalized);
+    const float weighted = __fmul_rn(
+        __bfloat162float(normalized_bf16), __bfloat162float(weight[column]));
+    output[column] = __float2bfloat16_rn(weighted);
+  }
+}
