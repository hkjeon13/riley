+                == &teacher_data[step * row_bytes..(step + 1) * row_bytes],
+        );
+        for spec in expected_stage_specs() {
+            let name = format!("decode_step_{step}.{}", spec.name);
+            let expected = hf.tensors.get(&name).ok_or("HF M1/M2 stage missing")?;
