+    let cleanup = close_decode_resources(Some(decode), stream, context);
+    let observed = match (execution, cleanup) {
+        (Ok(value), Ok(())) => value,
+        (Err(error), Ok(())) | (Ok(_), Err(error)) => return Err(error),
+        (Err(error), Err(other)) => {
+            return Err(format!("M1/M2 failed: {error}; cleanup: {other}").into());
+        }
