+fn qwen3b_p2048_cache_on_m1_m2_bounded_full_forward_quality_gate() -> TestResult {
+    let repository = repository_root()?;
+    let native_path = "kernels/src/decode_attention.cu";
+    let native_hash = sha256_file(&regular_file(
