+/// Collect actual selected-layer names alongside every global layer output.
+/// This observer changes neither native arithmetic nor the decode selector.
+fn collect_full128_selected_layer_trace(
+    trace: &PreparedLlamaDecodeM1Trace,
+) -> TestResult<BTreeMap<String, Vec<u8>>> {
+    if !trace.is_complete() {
+        return Err("full128 selected trace incomplete".into());
+    }
+    let selected = trace.detailed_layer_index();
+    let mut observed = BTreeMap::new();
+    observed.insert(
+        "embedding.last".to_owned(),
+        canonical_bf16_le(trace.embedding().ok_or("embedding missing")?)?,
+    );
+    for stage in LlamaLastTokenLayerStage::ALL {
+        observed.insert(
+            format!("layer{selected}.{}.last", stage.name()),
+            canonical_bf16_le(
+                trace
+                    .detailed_layer(stage)
+                    .ok_or("selected stage missing")?,
+            )?,
+        );
+    }
+    for layer in 0..QWEN3B_LAYER_COUNT {
+        let name = format!("layer{layer}.output.last");
+        let row = canonical_bf16_le(
+            trace
+                .layer_output(layer)
+                .ok_or("global layer output missing")?,
+        )?;
+        if layer == selected && observed.get(&name) != Some(&row) {
+            return Err("selected residual disagrees with global layer output".into());
+        }
+        observed.insert(name, row);
+    }
+    observed.insert(
+        "final_norm.output.last".to_owned(),
+        canonical_bf16_le(trace.final_norm_output().ok_or("final norm missing")?)?,
+    );
+    observed.insert(
+        "last_logits".to_owned(),
+        canonical_bf16_le(trace.logits().ok_or("logits missing")?)?,
+    );
+    if observed.len() != 52 {
+        return Err("selected full128 stage count differs".into());
+    }
+    Ok(observed)
+}
