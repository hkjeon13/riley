+// Sparse shared-owner nodes indexed by physical page. Exclusive pages allocate
+// no nodes; duplicate detection preserves the original ledger iteration order.
+struct SharedOwnerIndex { heads:Vec<usize>, nodes:Vec<(u64,usize)> }
+impl SharedOwnerIndex {
+    fn new(pages:usize)->Self{Self{heads:vec![usize::MAX;pages],nodes:Vec::new()}}
+    fn contains(&self,page:u32,tag:u64)->bool {
+        let mut at=self.heads[page as usize];
+        while at!=usize::MAX {let (owner,next)=self.nodes[at];if owner==tag{return true;}at=next;}
+        false
+    }
+    fn insert(&mut self,page:u32,tag:u64)->bool {
+        if self.contains(page,tag){return false;}
+        let head=&mut self.heads[page as usize];self.nodes.push((tag,*head));*head=self.nodes.len()-1;true
+    }
+}
 pub fn validate<const ROWS:usize>(e:&Expectation<ROWS>)->Result<()> {
     validate_after(e,e.last_accepted_replay)
