From c595d45b902cc2845ff34dda87e4ba9acf561718 Mon Sep 17 00:00:00 2001
From: psyche <hkjeon13@gmail.com>
Date: Thu, 8 Oct 2026 12:04:55 +0900
Subject: [PATCH] Encode prompts on the submitting thread before engine
 admission

Batch11 C32 natural CPU samples place ~40% of engine-thread host time
between graph replays in prompt tokenization during admit, which stalls
every active decode row. The engine publishes its immutable tokenizer and
admits pre-encoded prompts; encode failures still surface from admit.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 crates/riley-model/src/model.rs   | 16 +++++--
 crates/riley-server/src/engine.rs | 79 ++++++++++++++++++++++++++++++-
 2 files changed, 89 insertions(+), 6 deletions(-)

diff --git a/crates/riley-model/src/model.rs b/crates/riley-model/src/model.rs
index d856cd5..8f2b5ba 100644
--- a/crates/riley-model/src/model.rs
+++ b/crates/riley-model/src/model.rs
@@ -1,5 +1,6 @@
 use std::collections::BTreeSet;
 use std::path::{Path, PathBuf};
+use std::sync::Arc;
 
 use crate::artifact::VerifiedArtifactSession;
 use crate::{
@@ -25,7 +26,7 @@ pub const TOKENIZER_CONFIG_FILENAME: &str = "tokenizer_config.json";
 pub struct LoadedModel {
     config: ModelConfig,
     spec: ModelSpec,
-    tokenizer: Box<dyn Tokenizer>,
+    tokenizer: Arc<dyn Tokenizer>,
     qwen2_tokenizer_config: Option<Qwen2TokenizerConfig>,
     weights: LoadedWeights,
     verified_files: BTreeSet<PathBuf>,
@@ -63,7 +64,7 @@ impl LoadedModel {
             "tokenizer.json",
         )?;
         let (tokenizer, qwen2_tokenizer_config): (
-            Box<dyn Tokenizer>,
+            Arc<dyn Tokenizer>,
             Option<Qwen2TokenizerConfig>,
         ) = match config.family() {
             ModelFamily::Llama => {
@@ -72,7 +73,7 @@ impl LoadedModel {
                     limits,
                 )?;
                 validate_dense_tokenizer_coherence(&spec, &tokenizer)?;
-                (Box::new(tokenizer), None)
+                (Arc::new(tokenizer), None)
             }
             ModelFamily::Qwen2 => {
                 let tokenizer = Qwen2Tokenizer::from_json_slice_with_limits(
@@ -91,7 +92,7 @@ impl LoadedModel {
                 )?;
                 tokenizer_config.validate_tokenizer(&tokenizer)?;
                 validate_qwen_context_bound(&spec, &tokenizer_config)?;
-                (Box::new(tokenizer), Some(tokenizer_config))
+                (Arc::new(tokenizer), Some(tokenizer_config))
             }
         };
 
@@ -126,6 +127,13 @@ impl LoadedModel {
         self.tokenizer.as_ref()
     }
 
+    /// Returns a shared handle to the same immutable tokenizer, so prompts can
+    /// be encoded off the thread that owns the model.
+    #[must_use]
+    pub fn shared_tokenizer(&self) -> Arc<dyn Tokenizer> {
+        Arc::clone(&self.tokenizer)
+    }
+
     /// Returns validated Qwen chat metadata, or `None` for a non-Qwen model.
     #[must_use]
     pub const fn qwen2_tokenizer_config(&self) -> Option<&Qwen2TokenizerConfig> {
diff --git a/crates/riley-server/src/engine.rs b/crates/riley-server/src/engine.rs
index 05274af..cfd044a 100644
--- a/crates/riley-server/src/engine.rs
+++ b/crates/riley-server/src/engine.rs
@@ -13,7 +13,7 @@ use std::sync::atomic::{AtomicU8, AtomicU64, AtomicUsize, Ordering};
 use std::sync::mpsc::{
     self, Receiver, RecvError, RecvTimeoutError, SyncSender, TryRecvError, TrySendError,
 };
-use std::sync::{Arc, Condvar, Mutex};
+use std::sync::{Arc, Condvar, Mutex, OnceLock};
 use std::thread::{self, JoinHandle};
 use std::time::{Duration, Instant, SystemTime, UNIX_EPOCH};
 
@@ -280,6 +280,30 @@ pub trait EngineBackend: 'static {
         request: &GenerationRequest,
     ) -> Result<(), BackendError>;
 
+    /// Immutable tokenizer that submitters may run before admission, keeping
+    /// prompt encoding off the engine thread.
+    #[must_use]
+    fn prompt_tokenizer(&self) -> Option<Arc<dyn riley_model::Tokenizer>> {
+        None
+    }
+
+    /// Admits a request whose prompt was already encoded by `prompt_tokenizer`
+    /// with the options `admit` uses.
+    ///
+    /// # Errors
+    ///
+    /// Same as `admit`.
+    fn admit_tokenized(
+        &mut self,
+        request_id: EngineRequestId,
+        metadata: &RequestMetadata,
+        request: &GenerationRequest,
+        prompt_token_ids: Vec<u32>,
+    ) -> Result<(), BackendError> {
+        let _ = prompt_token_ids;
+        self.admit(request_id, metadata, request)
+    }
+
     /// Cancels queued or active work at a safe iteration boundary.
     ///
     /// Returned events are published in vector order.
@@ -351,6 +375,7 @@ enum Command {
         request_id: EngineRequestId,
         metadata: RequestMetadata,
         request: GenerationRequest,
+        prompt_token_ids: Option<Vec<u32>>,
         cancellation: Arc<AtomicU8>,
         events: SyncSender<GenerationEvent>,
         admitted: SyncSender<Result<(), EngineError>>,
@@ -421,6 +446,7 @@ struct EngineInner {
     lifecycle: Arc<Lifecycle>,
     next_request_id: AtomicU64,
     stats: Arc<EngineStats>,
+    prompt_tokenizer: Arc<OnceLock<Arc<dyn riley_model::Tokenizer>>>,
     worker: Mutex<Option<JoinHandle<()>>>,
 }
 
@@ -1086,6 +1112,8 @@ impl InferenceEngine {
         let worker_lifecycle = Arc::clone(&lifecycle);
         let stats = Arc::new(EngineStats::default());
         let worker_stats = Arc::clone(&stats);
+        let prompt_tokenizer = Arc::new(OnceLock::new());
+        let worker_tokenizer = Arc::clone(&prompt_tokenizer);
         let worker = thread::Builder::new()
             .name("riley-engine".to_owned())
             .spawn(move || {
@@ -1097,6 +1125,10 @@ impl InferenceEngine {
                         return;
                     }
                 };
+                // Published before the worker reports ready.
+                if let Some(tokenizer) = backend.prompt_tokenizer() {
+                    let _ = worker_tokenizer.set(tokenizer);
+                }
                 worker_main(
                     backend,
                     config,
@@ -1113,6 +1145,7 @@ impl InferenceEngine {
             lifecycle,
             next_request_id: AtomicU64::new(1),
             stats,
+            prompt_tokenizer,
             worker: Mutex::new(Some(worker)),
         });
         let engine = Self { inner };
@@ -1263,10 +1296,23 @@ impl InferenceEngine {
         let cancellation = Arc::new(AtomicU8::new(REQUEST_LIVE));
         let (event_tx, event_rx) = mpsc::sync_channel(self.inner.config.event_channel_capacity);
         let (admitted_tx, admitted_rx) = mpsc::sync_channel(1);
+        // Encode on the submitting thread. A failure is left for admission to
+        // reproduce, so request validation order and errors are unchanged.
+        let prompt_token_ids = self.inner.prompt_tokenizer.get().and_then(|tokenizer| {
+            tokenizer
+                .encode(
+                    &request.prompt,
+                    riley_model::EncodeOptions {
+                        add_special_tokens: true,
+                    },
+                )
+                .ok()
+        });
         let command = Command::Submit {
             request_id,
             metadata: metadata.clone(),
             request,
+            prompt_token_ids,
             cancellation: Arc::clone(&cancellation),
             events: event_tx,
             admitted: admitted_tx,
@@ -1659,6 +1705,7 @@ fn process_command<B: EngineBackend>(
         request_id,
         metadata,
         request,
+        prompt_token_ids,
         cancellation,
         events,
         admitted,
@@ -1690,7 +1737,11 @@ fn process_command<B: EngineBackend>(
         let _ = admitted.try_send(Err(EngineError::InvalidRequest));
         return;
     }
-    match backend.admit(request_id, &metadata, &request) {
+    let admission = match prompt_token_ids {
+        Some(ids) => backend.admit_tokenized(request_id, &metadata, &request, ids),
+        None => backend.admit(request_id, &metadata, &request),
+    };
+    match admission {
         Ok(()) => {
             let replaced = requests.insert(
                 request_id,
@@ -3238,6 +3289,30 @@ mod cuda_backend {
                     },
                 )
                 .map_err(|_| private_request_error("prompt tokenization failed"))?;
+            self.admit_tokenized(request_id, metadata, request, prompt_token_ids)
+        }
+
+        fn prompt_tokenizer(&self) -> Option<Arc<dyn riley_model::Tokenizer>> {
+            Some(self.model.shared_tokenizer())
+        }
+
+        fn admit_tokenized(
+            &mut self,
+            request_id: EngineRequestId,
+            metadata: &RequestMetadata,
+            request: &GenerationRequest,
+            prompt_token_ids: Vec<u32>,
+        ) -> Result<(), BackendError> {
+            if request.model_id != self.metadata.model_id {
+                return Err(private_request_error("request selected a different model"));
+            }
+            if request.max_new_tokens == 0
+                || request.max_new_tokens > self.metadata.max_output_tokens
+            {
+                return Err(private_request_error(
+                    "requested output token count is outside server bounds",
+                ));
+            }
             if let Some(graph) = &self.decode_graph {
                 graph
                     .validate_request_shape(prompt_token_ids.len(), request.max_new_tokens)
