From 2a9d9eb5a397005ca01d8671083e7cb42520c994 Mon Sep 17 00:00:00 2001
From: psyche <hkjeon13@gmail.com>
Date: Thu, 8 Oct 2026 12:01:08 +0900
Subject: [PATCH] Replace hashed and tree block-ownership validation with dense
 tables

Batch11 profiles attribute 16-17% of C32 wall time to host work between
graph replays, growing with live KV blocks. The same ownership, aliasing
and identity checks now use pool-bounded bitmaps and prefix scans.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .../llama/multi_descriptor/variable_wire.rs   | 22 +++++---
 crates/riley-scheduler/src/plan.rs            | 56 ++++++++++++++-----
 crates/riley-scheduler/src/scheduler.rs       | 19 ++++++-
 3 files changed, 73 insertions(+), 24 deletions(-)

diff --git a/crates/riley-runtime/src/llama/multi_descriptor/variable_wire.rs b/crates/riley-runtime/src/llama/multi_descriptor/variable_wire.rs
index a403103..404f1b1 100644
--- a/crates/riley-runtime/src/llama/multi_descriptor/variable_wire.rs
+++ b/crates/riley-runtime/src/llama/multi_descriptor/variable_wire.rs
@@ -2,7 +2,7 @@
 //! V3 retains eight rows; V4 uses sixteen. Packet bytes never establish ownership.
 use super::{check, overflow, BlockOwnership, Result, ResultMode};
 use super::shape_progress::{InputStage, Progress};
-use std::collections::{BTreeMap, BTreeSet};
+
 pub const HEADER_BYTES:usize=128;
 pub const ROW_BYTES:usize=1664; // 128 header +256*u32 pages +256*u16 valid counts
 pub const TOKENS_OFFSET:usize=HEADER_BYTES+8*ROW_BYTES;
@@ -58,23 +58,27 @@ pub fn validate<const ROWS:usize>(e:&Expectation<ROWS>)->Result<()> {
     let total=e.rows.iter().try_fold(0usize,|n,r|n.checked_add(r.input_tokens.len()).ok_or_else(||overflow("tokens")))?;
     check(e.stage!=InputStage::Prefill || total<=1024,"tokens","packed token capacity exceeded")?;
     check(e.physical_block_count>0 && e.physical_block_count<=4096,"pool","unsupported physical pool")?;
-    let mut ownership=BTreeMap::new();
+    // The pool bound above makes dense tables exact; zero is never a valid tag.
+    let mut ownership=[0u64;4096];
     for x in &e.block_ownership {
-        check(x.sequence_tag!=0 && x.physical_id<e.physical_block_count && ownership.insert(x.physical_id,x.sequence_tag).is_none(),"ownership","invalid or duplicate ledger entry")?;
+        check(x.sequence_tag!=0 && x.physical_id<e.physical_block_count && ownership[x.physical_id as usize]==0,"ownership","invalid or duplicate ledger entry")?;
+        ownership[x.physical_id as usize]=x.sequence_tag;
     }
     let published=e.rows.iter().filter(|r|r.progress.committed_tokens.checked_add(r.progress.input_tokens)==Some(r.progress.prompt_tokens) || r.progress.stage==InputStage::Decode).count();
-    let (mut tags,mut cookies,mut slots,mut used)=(BTreeSet::new(),BTreeSet::new(),BTreeSet::new(),BTreeSet::new());
-    for row in &e.rows {
-        check(row.sequence_tag!=0 && tags.insert(row.sequence_tag) && row.cookie!=0 && cookies.insert(row.cookie),"row_identity","duplicate or zero request identity")?;
-        check(row.output_slot<e.rows.len() as u32 && slots.insert(row.output_slot),"slot","slots not unique and dense")?;
+    let (mut slots,mut used)=(0u32,[0u64;64]);
+    for (index,row) in e.rows.iter().enumerate() {
+        check(row.sequence_tag!=0 && row.cookie!=0 && e.rows[..index].iter().all(|p|p.sequence_tag!=row.sequence_tag && p.cookie!=row.cookie),"row_identity","duplicate or zero request identity")?;
+        check(row.output_slot<e.rows.len() as u32 && slots&(1<<row.output_slot)==0,"slot","slots not unique and dense")?;
+        slots|=1<<row.output_slot;
         check(e.mixed_execution || row.progress.stage==e.stage,"stage","row stage differs")?;
         let v=row.progress.validate()?;
         if e.packed_prefill {check(((row.output_slot as usize)<published)==v.logits_input_row.is_some(),"slot","published slots must precede internal partial slots")?;}
         check(row.input_tokens.len()==row.progress.input_tokens as usize && row.input_tokens.iter().all(|&t|t<49152),"tokens","invalid token count or vocabulary")?;
         check(row.physical_ids.len()==v.live_pages as usize && row.valid_tokens.len()==v.live_pages as usize,"pages","page map does not cover target exactly")?;
         for (i,(&id,&valid)) in row.physical_ids.iter().zip(&row.valid_tokens).enumerate() {
-            check(id<e.physical_block_count && used.insert(id),"pages","out of pool or aliased pages")?;
-            check(ownership.get(&id)==Some(&row.sequence_tag),"ownership","page not reserved by this request")?;
+            check(id<e.physical_block_count && used[id as usize/64]&(1<<(id%64))==0,"pages","out of pool or aliased pages")?;
+            used[id as usize/64]|=1<<(id%64);
+            check(ownership[id as usize]==row.sequence_tag,"ownership","page not reserved by this request")?;
             check(valid==if i+1==row.physical_ids.len(){v.last_page_tokens}else{16},"valid_tokens","invalid page occupancy")?;
         }
     }
diff --git a/crates/riley-scheduler/src/plan.rs b/crates/riley-scheduler/src/plan.rs
index aaa08f5..fd4792f 100644
--- a/crates/riley-scheduler/src/plan.rs
+++ b/crates/riley-scheduler/src/plan.rs
@@ -108,18 +108,27 @@ impl OwnedBlockTable {
                 reason: "block count must exactly address the logical length",
             });
         }
+        // Serving tables are short; scanning the prefix avoids a hashed set.
+        let scan_prefix = physical_block_ids.len() <= 64;
         let mut unique_ids = HashSet::new();
-        unique_ids
-            .try_reserve(physical_block_ids.len())
-            .map_err(|_| SchedulerError::HostAllocation {
-                resource: "block table physical ID set",
-                requested_elements: physical_block_ids.len(),
-            })?;
+        if !scan_prefix {
+            unique_ids
+                .try_reserve(physical_block_ids.len())
+                .map_err(|_| SchedulerError::HostAllocation {
+                    resource: "block table physical ID set",
+                    requested_elements: physical_block_ids.len(),
+                })?;
+        }
         let mut token_sum = 0_usize;
         for (index, (&physical_id, &valid)) in
             physical_block_ids.iter().zip(&valid_tokens).enumerate()
         {
-            if !unique_ids.insert(physical_id) {
+            let duplicate = if scan_prefix {
+                physical_block_ids[..index].contains(&physical_id)
+            } else {
+                !unique_ids.insert(physical_id)
+            };
+            if duplicate {
                 return Err(SchedulerError::InvalidPlan {
                     field: "block_tables",
                     reason: "physical block IDs must be unique within one table",
@@ -569,16 +578,35 @@ fn validate_iteration_block_tables(
             field: "iteration physical block entry count",
         });
     };
+    // Pool-issued IDs are small and dense, so a bitmap replaces the hashed set;
+    // arbitrary large IDs keep the general path.
+    const DENSE_BLOCK_ID_LIMIT: u32 = 1 << 16;
+    let dense = block_tables
+        .iter()
+        .flat_map(|table| &table.physical_block_ids)
+        .all(|&id| id < DENSE_BLOCK_ID_LIMIT);
+    let mut dense_ids = [0_u64; (DENSE_BLOCK_ID_LIMIT / 64) as usize];
     let mut physical_block_ids = HashSet::new();
-    physical_block_ids
-        .try_reserve(block_entry_count)
-        .map_err(|_| SchedulerError::HostAllocation {
-            resource: "iteration physical block identity set",
-            requested_elements: block_entry_count,
-        })?;
+    if !dense {
+        physical_block_ids
+            .try_reserve(block_entry_count)
+            .map_err(|_| SchedulerError::HostAllocation {
+                resource: "iteration physical block identity set",
+                requested_elements: block_entry_count,
+            })?;
+    }
     for table in block_tables {
         for &physical_block_id in &table.physical_block_ids {
-            if !physical_block_ids.insert(physical_block_id) {
+            let duplicate = if dense {
+                let word = &mut dense_ids[(physical_block_id / 64) as usize];
+                let bit = 1_u64 << (physical_block_id % 64);
+                let seen = *word & bit != 0;
+                *word |= bit;
+                seen
+            } else {
+                !physical_block_ids.insert(physical_block_id)
+            };
+            if duplicate {
                 return Err(SchedulerError::InvalidPlan {
                     field: "block_tables",
                     reason: "physical block IDs must be unique across the iteration",
diff --git a/crates/riley-scheduler/src/scheduler.rs b/crates/riley-scheduler/src/scheduler.rs
index b7e4643..33550a5 100644
--- a/crates/riley-scheduler/src/scheduler.rs
+++ b/crates/riley-scheduler/src/scheduler.rs
@@ -3279,6 +3279,13 @@ impl Scheduler {
             self.pool.layout().physical_block_count(),
             "execution block ownership",
         )?;
+        let mut owned = Vec::new();
+        try_reserve_exact(
+            &mut owned,
+            self.pool.layout().physical_block_count().div_ceil(64),
+            "execution block ownership bitmap",
+        )?;
+        owned.resize(self.pool.layout().physical_block_count().div_ceil(64), 0_u64);
         for record in &self.requests {
             let Some(sequence) = record.sequence.as_ref() else {
                 continue;
@@ -3293,7 +3300,17 @@ impl Scheduler {
                 sequence.block_table()?
             };
             for &physical in table.physical_block_ids() {
-                if block_owners.iter().any(|(id, _)| *id == physical) {
+                // Pool IDs index the bitmap; anything else keeps the exact scan.
+                let duplicate = match owned.get_mut(physical as usize / 64) {
+                    Some(word) => {
+                        let bit = 1_u64 << (physical % 64);
+                        let seen = *word & bit != 0;
+                        *word |= bit;
+                        seen
+                    }
+                    None => block_owners.iter().any(|(id, _)| *id == physical),
+                };
+                if duplicate {
                     return Err(bad());
                 }
                 block_owners.push((physical, record.request_id));
