From 36a788359a8711e9543d8815b7446d32cfecb283 Mon Sep 17 00:00:00 2001
From: psyche <hkjeon13@gmail.com>
Date: Thu, 8 Oct 2026 12:10:12 +0900
Subject: [PATCH] Pre-encode prompts only while the engine has active requests

An idle engine gains nothing from off-thread encoding, and the C1 fixed
diagnostic showed TTFT 3.05 -> 3.24 ms when the submitting thread encoded.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 crates/riley-server/src/engine.rs | 10 +++++++---
 1 file changed, 7 insertions(+), 3 deletions(-)

diff --git a/crates/riley-server/src/engine.rs b/crates/riley-server/src/engine.rs
index cfd044a..3d38157 100644
--- a/crates/riley-server/src/engine.rs
+++ b/crates/riley-server/src/engine.rs
@@ -1296,9 +1296,13 @@ impl InferenceEngine {
         let cancellation = Arc::new(AtomicU8::new(REQUEST_LIVE));
         let (event_tx, event_rx) = mpsc::sync_channel(self.inner.config.event_channel_capacity);
         let (admitted_tx, admitted_rx) = mpsc::sync_channel(1);
-        // Encode on the submitting thread. A failure is left for admission to
-        // reproduce, so request validation order and errors are unchanged.
-        let prompt_token_ids = self.inner.prompt_tokenizer.get().and_then(|tokenizer| {
+        // Encode on the submitting thread while the engine is serving others,
+        // so admission does not stall their decode rows; an idle engine encodes
+        // itself. A failure is left for admission to reproduce, so request
+        // validation order and errors are unchanged.
+        let engine_busy = self.inner.stats.active_requests.load(Ordering::Acquire) != 0;
+        let prompt_tokenizer = self.inner.prompt_tokenizer.get().filter(|_| engine_busy);
+        let prompt_token_ids = prompt_tokenizer.and_then(|tokenizer| {
             tokenizer
                 .encode(
                     &request.prompt,
