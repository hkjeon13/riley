diff --git a/kernels/src/weight_prefetch.cuh b/kernels/src/weight_prefetch.cuh
new file mode 100644
index 00000000..6083e4ba
--- /dev/null
+++ b/kernels/src/weight_prefetch.cuh
@@ -0,0 +1,13 @@
+#pragma once
+#include <cuda_runtime.h>
+#include <stdint.h>
+// Touches one word of every 64-byte line in [bytes, bytes+count) so that a
+// later kernel finds those weights in the device L2 cache. Loads only: no
+// value is kept and nothing is written, so results cannot change. `slot` is
+// this thread's index among the `slots` threads sharing the range.
+__device__ __forceinline__ void riley_touch_weight_lines(const void* bytes,uint64_t count,uint64_t slot,uint64_t slots){
+ const uint64_t lines=count/64,per=(lines+slots-1)/slots,first=slot*per;
+ const auto* base=static_cast<const volatile uint8_t*>(bytes);uint32_t unused=0;
+ for(uint64_t line=first;line<first+per&&line<lines;++line)unused^=*reinterpret_cast<const volatile uint32_t*>(base+line*64);
+ (void)unused;
+}
