+int merge_norm_prefetch_cases(int seed){
+ constexpr size_t N=32*576,Guard=16;
+ auto* parts=alloc<float>(5*N);auto* skip_bf=alloc<__nv_bfloat16>(N);auto* skip_fp=alloc<float>(N);auto* weight=alloc<__nv_bfloat16>(576);auto* touched=alloc<__nv_bfloat16>(884736/2);
