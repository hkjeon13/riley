From 61743e21235e9bf4e5e84b983b0168fc85bdc1e9 Mon Sep 17 00:00:00 2001
From: psyche <hkjeon13@gmail.com>
Date: Sun, 11 Oct 2026 14:29:12 +0900
Subject: [PATCH 1/5] Look up the owning request of a packed prefill row with
 one warp ballot

mixed_rope_kv_v7 scanned the owners sequentially in every thread, so the
kernel went from 1.8 us with one owner to 8 us with thirty-two. Each lane now
tests one owner and the lowest hit is taken, which selects the same owner. The
native test compares query and cache writes against the scanning kernel for
packed, gapped, empty and invalid owner tables.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 kernels/src/mixed_rope_v49.cuh                |  6 +++-
 kernels/tests/kernel_batch14_correctness.cu   | 34 ++++++++++++++++++-
 .../mixed_rope_v49_batch13_reference.cuh      | 29 ++++++++++++++++
 3 files changed, 67 insertions(+), 2 deletions(-)
 create mode 100644 kernels/tests/reference/mixed_rope_v49_batch13_reference.cuh

diff --git a/kernels/src/mixed_rope_v49.cuh b/kernels/src/mixed_rope_v49.cuh
index 9d20a066..79ebc410 100644
--- a/kernels/src/mixed_rope_v49.cuh
+++ b/kernels/src/mixed_rope_v49.cuh
@@ -9,7 +9,11 @@ __global__ void mixed_rope_kv_v7(const __nv_bfloat16* q,const __nv_bfloat16* k,c
  __nv_bfloat16* qo,__nv_bfloat16* keys,__nv_bfloat16* values,const float* cos,const float* sin,
  const uint32_t* meta,uint32_t capacity){
  const uint32_t row=blockIdx.y,active=meta[5],total=meta[9];if(!active||active>32||!total||total>capacity||row>=total)return;
- uint32_t owner=0;for(;owner<active;++owner){const auto* s=meta+32+owner*416;if(row>=s[16]&&row-s[16]<s[2])break;}if(owner==active)return;
+ // Lowest owner whose packed row range holds this row. Each lane tests one
+ // owner, so the lookup costs one load instead of a scan over all owners.
+ bool holds=false;{const uint32_t candidate=threadIdx.x%32;if(candidate<active){const auto* s=meta+32+candidate*416;holds=row>=s[16]&&row-s[16]<s[2];}}
+ const uint32_t holders=__ballot_sync(0xffffffffu,holds);if(!holders)return;
+ const uint32_t owner=__ffs(holders)-1;
  const auto* shape=meta+32+owner*416;const auto* pages=shape+32;const uint32_t pos=shape[4]+row-shape[16];
  int i=threadIdx.x+blockIdx.x*blockDim.x;if(i>=384)return;
  int head=i/32,dim=i%32;
diff --git a/kernels/tests/kernel_batch14_correctness.cu b/kernels/tests/kernel_batch14_correctness.cu
index 6988c416..149846be 100644
--- a/kernels/tests/kernel_batch14_correctness.cu
+++ b/kernels/tests/kernel_batch14_correctness.cu
@@ -61,4 +61,36 @@ int fused_qkv_cases(int seed){
  }
  for(void* p:{(void*)x,(void*)qw,(void*)kw,(void*)vw,(void*)pa,(void*)pb,(void*)qa,(void*)qb,(void*)ka,(void*)kb,(void*)va,(void*)vb,(void*)cos,(void*)sin,(void*)shape,(void*)pages,(void*)live})OK(cudaFree(p));return cases;
 }
-int main(){kernel_batch11_matrix_main();int fused=0;for(int seed:{1,17,99})fused+=fused_qkv_cases(seed);std::printf("{\"passed\":true,\"fused_qkv_cases\":%d,\"BF16_and_FP32_exact\":true,\"performance_claim_eligible\":false}\n",fused);int narrow=0;for(int seed:{1,17,99})narrow+=narrow_attention_cases(seed);OK(cudaDeviceSynchronize());std::printf("{\"passed\":true,\"narrow_grid_attention_cases\":%d,\"BF16_and_FP32_exact\":true,\"performance_claim_eligible\":false}\n",narrow);}
+#include "mixed_rope_v49.cuh"
+#include "reference/mixed_rope_v49_batch13_reference.cuh"
+int mixed_rope_cases(int seed){
+ constexpr int Capacity=512,Physical=256,KV=Physical*3*16*64,Guard=16,Meta=32+32*416;
+ auto* q=alloc<__nv_bfloat16>(Capacity*576);auto* k=alloc<__nv_bfloat16>(Capacity*192);auto* v=alloc<__nv_bfloat16>(Capacity*192);
+ auto* qa=alloc<__nv_bfloat16>(Capacity*576+2*Guard);auto* qb=alloc<__nv_bfloat16>(Capacity*576+2*Guard);
+ auto* ka=alloc<__nv_bfloat16>(KV+2*Guard);auto* kb=alloc<__nv_bfloat16>(KV+2*Guard);auto* va=alloc<__nv_bfloat16>(KV+2*Guard);auto* vb=alloc<__nv_bfloat16>(KV+2*Guard);
+ auto* cos=alloc<float>(4096*32);auto* sin=alloc<float>(4096*32);auto* meta=alloc<uint32_t>(Meta);
+ for(int i=0;i<Capacity*576;++i)q[i]=__float2bfloat16_rn(float((i*17+seed)%127-63)/128);
+ for(int i=0;i<Capacity*192;++i){k[i]=__float2bfloat16_rn(float((i*7+seed)%131-65)/128);v[i]=__float2bfloat16_rn(float((i*13+seed)%251-125)/128);}
+ for(int i=0;i<4096*32;++i){cos[i]=std::cos(float(i%977)*.0131F+seed);sin[i]=std::sin(float(i%977)*.0131F+seed);}
+ int cases=0;
+ // owners, tokens per owner, start position, gap rows left unowned between owners, total override (0 = packed total)
+ const int shapes[][5]={{1,1,0,0,0},{1,128,0,0,0},{1,512,3,0,0},{2,128,5,0,0},{4,128,0,0,0},{5,17,31,0,0},{32,1,200,0,0},{32,16,0,0,0},{31,1,77,0,0},{3,100,9,7,0},{16,8,1000,3,0},
+                        {2,64,0,0,513},{2,64,0,0,64},{0,8,0,0,8},{33,1,0,0,33}};
+ for(const auto& sh:shapes){
+  std::memset(meta,0,Meta*4);const int owners=sh[0],count=sh[1];int offset=0;
+  for(int owner=0;owner<owners&&owner<32;++owner){auto* shape=meta+32+owner*416;shape[2]=count;shape[4]=sh[2]+owner*3;shape[16]=offset;offset+=count+sh[3];
+   // Each owner writes distinct physical pages.
+   for(int p=0;p<256;++p)shape[32+p]=(owner*8+p)%Physical;}
+  meta[5]=owners;meta[9]=sh[4]?sh[4]:offset;
+  fill_bf16(qa,Capacity*576+2*Guard);fill_bf16(qb,Capacity*576+2*Guard);fill_bf16(ka,KV+2*Guard);fill_bf16(kb,KV+2*Guard);fill_bf16(va,KV+2*Guard);fill_bf16(vb,KV+2*Guard);
+  mixed_rope_kv_v7_batch13_reference<<<dim3(2,Capacity),256>>>(q,k,v,qa+Guard,ka+Guard,va+Guard,cos,sin,meta,Capacity);
+  mixed_rope_kv_v7<<<dim3(2,Capacity),256>>>(q,k,v,qb+Guard,kb+Guard,vb+Guard,cos,sin,meta,Capacity);
+  OK(cudaGetLastError());OK(cudaDeviceSynchronize());
+  compare(qa,qb,Capacity*576+2*Guard,"mixed RoPE query including guards/unowned rows",owners);
+  compare(ka,kb,KV+2*Guard,"mixed RoPE cache keys including guards/untouched",owners);
+  compare(va,vb,KV+2*Guard,"mixed RoPE cache values including guards/untouched",owners);
+  ++cases;
+ }
+ for(void* p:{(void*)q,(void*)k,(void*)v,(void*)qa,(void*)qb,(void*)ka,(void*)kb,(void*)va,(void*)vb,(void*)cos,(void*)sin,(void*)meta})OK(cudaFree(p));return cases;
+}
+int main(){kernel_batch11_matrix_main();{int mixed=0;for(int seed:{1,17,99})mixed+=mixed_rope_cases(seed);std::printf("{\"passed\":true,\"mixed_rope_cases\":%d,\"BF16_exact\":true,\"performance_claim_eligible\":false}\n",mixed);}int fused=0;for(int seed:{1,17,99})fused+=fused_qkv_cases(seed);std::printf("{\"passed\":true,\"fused_qkv_cases\":%d,\"BF16_and_FP32_exact\":true,\"performance_claim_eligible\":false}\n",fused);int narrow=0;for(int seed:{1,17,99})narrow+=narrow_attention_cases(seed);OK(cudaDeviceSynchronize());std::printf("{\"passed\":true,\"narrow_grid_attention_cases\":%d,\"BF16_and_FP32_exact\":true,\"performance_claim_eligible\":false}\n",narrow);}
diff --git a/kernels/tests/reference/mixed_rope_v49_batch13_reference.cuh b/kernels/tests/reference/mixed_rope_v49_batch13_reference.cuh
new file mode 100644
index 00000000..822094ed
--- /dev/null
+++ b/kernels/tests/reference/mixed_rope_v49_batch13_reference.cuh
@@ -0,0 +1,29 @@
+// Internal variable-prefill primitive, not a serving entry point.
+// Caller retains all parents and validates a unique logical-to-physical page map,
+// its full extent, and allocation sizes before enqueue; no host publication here.
+#ifndef RILEY_BATCH13_MIXED_ROPE_REFERENCE
+#define RILEY_BATCH13_MIXED_ROPE_REFERENCE
+#include <cuda_runtime.h>
+#include <cuda_bf16.h>
+#include <stdint.h>
+__global__ void mixed_rope_kv_v7_batch13_reference(const __nv_bfloat16* q,const __nv_bfloat16* k,const __nv_bfloat16* v,
+ __nv_bfloat16* qo,__nv_bfloat16* keys,__nv_bfloat16* values,const float* cos,const float* sin,
+ const uint32_t* meta,uint32_t capacity){
+ const uint32_t row=blockIdx.y,active=meta[5],total=meta[9];if(!active||active>32||!total||total>capacity||row>=total)return;
+ uint32_t owner=0;for(;owner<active;++owner){const auto* s=meta+32+owner*416;if(row>=s[16]&&row-s[16]<s[2])break;}if(owner==active)return;
+ const auto* shape=meta+32+owner*416;const auto* pages=shape+32;const uint32_t pos=shape[4]+row-shape[16];
+ int i=threadIdx.x+blockIdx.x*blockDim.x;if(i>=384)return;
+ int head=i/32,dim=i%32;
+ float c=__bfloat162float(__float2bfloat16_rn(cos[pos*32+dim])),s=__bfloat162float(__float2bfloat16_rn(sin[pos*32+dim]));
+ const __nv_bfloat16* src=head<9?q+row*576:k+row*192;
+ int base=(head<9?head:head-9)*64;
+ float a=__bfloat162float(src[base+dim]),b=__bfloat162float(src[base+dim+32]);
+ const __nv_bfloat16 first=__float2bfloat16_rn(a*c-b*s),second=__float2bfloat16_rn(b*c+a*s);
+ if(head<9){qo[row*576+base+dim]=first;qo[row*576+base+dim+32]=second;}
+ else{
+  uint32_t destination=((pages[pos/16]*3+head-9)*16+pos%16)*64+dim;
+  keys[destination]=first;keys[destination+32]=second;
+  values[destination]=v[row*192+base+dim];values[destination+32]=v[row*192+base+dim+32];
+ }
+}
+#endif
