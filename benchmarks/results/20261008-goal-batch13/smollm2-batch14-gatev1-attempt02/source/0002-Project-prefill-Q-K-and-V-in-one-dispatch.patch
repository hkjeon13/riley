+#include "prefill_shape_projection.cuh"
+int prefill_qkv_cases(int seed){
+ constexpr uint32_t Capacity=512;constexpr size_t Guard=16;
+ auto* x=alloc<__nv_bfloat16>(Capacity*576);auto* qw=alloc<__nv_bfloat16>(576*576);auto* kw=alloc<__nv_bfloat16>(192*576);auto* vw=alloc<__nv_bfloat16>(192*576);
+ __nv_bfloat16* a[3];__nv_bfloat16* b[3];const size_t n[3]={Capacity*576,Capacity*192,Capacity*192};
+ for(int i=0;i<3;++i){a[i]=alloc<__nv_bfloat16>(n[i]+2*Guard);b[i]=alloc<__nv_bfloat16>(n[i]+2*Guard);}
+ auto* live=alloc<uint32_t>(1);
+ for(size_t i=0;i<Capacity*576;++i)x[i]=__float2bfloat16_rn(float((int(i)*17+seed)%127-63)/128);
+ for(int i=0;i<576*576;++i)qw[i]=__float2bfloat16_rn(float((i*7+seed)%131-65)/128);
+ for(int i=0;i<192*576;++i){kw[i]=__float2bfloat16_rn(float((i*11+seed)%113-56)/128);vw[i]=__float2bfloat16_rn(float((i*13+seed)%251-125)/128);}
+ if(seed==99)for(int i=0;i<576;++i)x[i]=__float2bfloat16_rn(i%2?3.0e38F:-3.0e38F);
+ int cases=0;
+ for(uint32_t rows:{0,1,2,7,8,9,15,16,17,31,32,33,127,128,129,159,160,255,256,257,511,512,513}){
+  *live=rows;for(int i=0;i<3;++i){fill_bf16(a[i],n[i]+2*Guard);fill_bf16(b[i],n[i]+2*Guard);}
+  gemm_prefill_shape_vector<576,576,192,2><<<dim3(36,Capacity/16),64>>>(x,qw,a[0]+Guard,Capacity,live);
+  gemm_prefill_shape_vector<192,576,192,1><<<dim3(24,Capacity/16),32>>>(x,kw,a[1]+Guard,Capacity,live);
+  gemm_prefill_shape_vector<192,576,192,1><<<dim3(24,Capacity/16),32>>>(x,vw,a[2]+Guard,Capacity,live);
+  gemm_prefill_qkv_vector<<<dim3(60,Capacity/16),64>>>(x,qw,kw,vw,b[0]+Guard,b[1]+Guard,b[2]+Guard,Capacity,live);
+  OK(cudaGetLastError());OK(cudaDeviceSynchronize());
+  for(int i=0;i<3;++i)compare(a[i],b[i],n[i]+2*Guard,"fused prefill QKV projection including guards/inactive",rows);
+  ++cases;
+ }
+ for(void* p:{(void*)x,(void*)qw,(void*)kw,(void*)vw,(void*)a[0],(void*)a[1],(void*)a[2],(void*)b[0],(void*)b[1],(void*)b[2],(void*)live})OK(cudaFree(p));return cases;
+}
+int main(){kernel_batch11_matrix_main();{int fused=0;for(int seed:{1,17,99})fused+=prefill_qkv_cases(seed);std::printf("{\"passed\":true,\"prefill_qkv_cases\":%d,\"BF16_exact\":true,\"performance_claim_eligible\":false}\n",fused);}{int mixed=0;for(int seed:{1,17,99})mixed+=mixed_rope_cases(seed);std::printf("{\"passed\":true,\"mixed_rope_cases\":%d,\"BF16_exact\":true,\"performance_claim_eligible\":false}\n",mixed);}int fused=0;for(int seed:{1,17,99})fused+=fused_qkv_cases(seed);std::printf("{\"passed\":true,\"fused_qkv_cases\":%d,\"BF16_and_FP32_exact\":true,\"performance_claim_eligible\":false}\n",fused);int narrow=0;for(int seed:{1,17,99})narrow+=narrow_attention_cases(seed);OK(cudaDeviceSynchronize());std::printf("{\"passed\":true,\"narrow_grid_attention_cases\":%d,\"BF16_and_FP32_exact\":true,\"performance_claim_eligible\":false}\n",narrow);}
