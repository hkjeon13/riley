index 779992c6..e787fdde 100644
--- a/crates/riley-cuda/src/batch.rs
+++ b/crates/riley-cuda/src/batch.rs
@@ -823,8 +823,28 @@ pub fn native_bf16_ragged_paged_split_gqa_d128_two_stage_shared_kv<
