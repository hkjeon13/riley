From 7824433578a5952708e7c5f12ac18de51a484c95 Mon Sep 17 00:00:00 2001
From: psyche <hkjeon13@gmail.com>
Date: Sun, 11 Oct 2026 11:42:55 +0900
Subject: [PATCH 4/4] Use the fused QKV dispatch in every shared32
 grouped-attention decode capture

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 kernels/src/graph_numerics_precise.cu | 4 ++--
 1 file changed, 2 insertions(+), 2 deletions(-)

diff --git a/kernels/src/graph_numerics_precise.cu b/kernels/src/graph_numerics_precise.cu
index 3fc9cc8c..cb78ccaa 100644
--- a/kernels/src/graph_numerics_precise.cu
+++ b/kernels/src/graph_numerics_precise.cu
@@ -355,10 +355,10 @@ cudaError_t enqueue_compiled_v5_shared_model(cudaStream_t s,void*const* d,const
  return riley_shared32_model::enqueue(s,d,w,m,k,v,static_cast<const float*>(c),static_cast<const float*>(sn),status,physical,context,tiled);
 }
 cudaError_t enqueue_compiled_v7_gqa_shared_model(cudaStream_t s,void*const* d,const void*const* w,const void* m,void* k,void* v,const void* c,const void* sn,uint32_t* status,uint32_t physical,uint32_t context,bool tiled) noexcept {
- return riley_shared32_model::enqueue(s,d,w,m,k,v,static_cast<const float*>(c),static_cast<const float*>(sn),status,physical,context,tiled,true);
+ return riley_shared32_model::enqueue(s,d,w,m,k,v,static_cast<const float*>(c),static_cast<const float*>(sn),status,physical,context,tiled,true,32,true);
 }
 cudaError_t enqueue_compiled_v7_gqa_shared_model_rows(cudaStream_t s,void*const* d,const void*const* w,const void* m,void* k,void* v,const void* c,const void* sn,uint32_t* status,uint32_t physical,uint32_t context,bool tiled,uint32_t attention_rows) noexcept {
- return riley_shared32_model::enqueue(s,d,w,m,k,v,static_cast<const float*>(c),static_cast<const float*>(sn),status,physical,context,tiled,true,attention_rows,attention_rows==1);
+ return riley_shared32_model::enqueue(s,d,w,m,k,v,static_cast<const float*>(c),static_cast<const float*>(sn),status,physical,context,tiled,true,attention_rows,true);
 }
 cudaError_t enqueue_compiled_v5_shared_result(cudaStream_t s,const void* m,const void* logits,const void* status,void* result) noexcept {
  return riley_shared32_result::enqueue<0x35524d52>(s,m,static_cast<const __nv_bfloat16*>(logits),static_cast<const uint32_t*>(status),result);
-- 
2.52.0

