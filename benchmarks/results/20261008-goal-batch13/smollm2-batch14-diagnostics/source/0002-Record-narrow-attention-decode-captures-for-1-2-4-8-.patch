From 2c0d9a238e5d0c78a4ba464bbb38ba945ca08a16 Mon Sep 17 00:00:00 2001
From: psyche <hkjeon13@gmail.com>
Date: Sun, 11 Oct 2026 11:18:14 +0900
Subject: [PATCH 2/4] Record narrow attention decode captures for 1, 2, 4, 8
 and 16 live rows

Generalizes the one-row capture: replay picks the smallest recorded row bound
that covers the packet's live count, and falls back to the capacity grids
above sixteen rows. Adds a native test comparing narrow launches against the
capacity grids bit for bit, guards and inactive rows included.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 kernels/src/graph_resources.cu              | 26 ++++++++++++++-------
 kernels/tests/kernel_batch14_correctness.cu | 12 +++++-----
 2 files changed, 24 insertions(+), 14 deletions(-)

diff --git a/kernels/src/graph_resources.cu b/kernels/src/graph_resources.cu
index 9bb077a9..1a63d2fa 100644
--- a/kernels/src/graph_resources.cu
+++ b/kernels/src/graph_resources.cu
@@ -10,6 +10,7 @@
 
 // The ledger remains the single authority for all retained parents. The
 // optional transfer graph is a lifecycle probe, not a model decode graph.
+static constexpr uint32_t kNarrowAttentionRows[5]={1,2,4,8,16};
 struct RileyCudaGraphResources {
   // Cold additional decode entries share the parent's single resource ledger.
   struct CatalogEntry {
@@ -41,9 +42,10 @@ struct RileyCudaGraphResources {
   // They share every parent and are only replayed sequentially on this stream.
   cudaGraph_t prefill_graph = nullptr;
   cudaGraphExec_t prefill_exec = nullptr;
-  // Index 2: decode stage captured with attention grids for one live row.
-  cudaGraph_t compact_graph[3]{};
-  cudaGraphExec_t compact_exec[3]{};
+  // Indices 2..6: decode stage captured with attention grids for at most
+  // 1, 2, 4, 8 and 16 live rows (kNarrowAttentionRows).
+  cudaGraph_t compact_graph[7]{};
+  cudaGraphExec_t compact_exec[7]{};
   bool compact_ready=false,last_compact=false;
   RileyCudaPinnedHostBuffer* input = nullptr;
   RileyCudaPinnedHostBuffer* output = nullptr;
@@ -210,6 +212,10 @@ extern "C" RileyCudaStatus riley_cuda_graph_resources_close(
       (*resources)->compact_graph[0] || (*resources)->compact_exec[0] ||
       (*resources)->compact_graph[1] || (*resources)->compact_exec[1] ||
       (*resources)->compact_graph[2] || (*resources)->compact_exec[2] ||
+      (*resources)->compact_graph[3] || (*resources)->compact_exec[3] ||
+      (*resources)->compact_graph[4] || (*resources)->compact_exec[4] ||
+      (*resources)->compact_graph[5] || (*resources)->compact_exec[5] ||
+      (*resources)->compact_graph[6] || (*resources)->compact_exec[6] ||
       (*resources)->catalog[0].graph || (*resources)->catalog[0].exec ||
       (*resources)->catalog[1].graph || (*resources)->catalog[1].exec ||
       (*resources)->catalog[2].graph || (*resources)->catalog[2].exec ||
@@ -247,7 +253,7 @@ extern "C" RileyCudaStatus riley_cuda_graph_resources_close(
       if (status == RILEY_CUDA_STATUS_SUCCESS) (*resources)->prefill_graph = nullptr;
       else (*resources)->completion_unknown = true;
     }
-    for(int i=0;i<3;++i){
+    for(int i=0;i<7;++i){
       if(status==RILEY_CUDA_STATUS_SUCCESS&&(*resources)->compact_exec[i]){
         status=runtime_error(cudaGraphExecDestroy((*resources)->compact_exec[i]),error,RILEY_CUDA_ERROR_STAGE_CLOSE,kClose);
         if(status==RILEY_CUDA_STATUS_SUCCESS)(*resources)->compact_exec[i]=nullptr;else (*resources)->completion_unknown=true;
@@ -377,8 +383,10 @@ extern "C" RileyCudaStatus riley_cuda_graph_resources_replay_transfer(
     if(mode==0){
       if(stage>(r->mixed_execution?2u:1u)||!r->compact_exec[stage==1?1:0])return reject(error,"compact stage capture missing");
       selected_exec=r->compact_exec[stage==1?1:0];r->last_compact=true;
-      // The one-row capture serves exactly one live row; every other count keeps the capacity grids.
-      if(stage==1&&r->compact_exec[2]){uint32_t live;std::memcpy(&live,source+20,4);if(live==1)selected_exec=r->compact_exec[2];}
+      // A narrow capture serves live counts up to its row bound; larger counts keep the capacity grids.
+      if(stage==1){uint32_t live;std::memcpy(&live,source+20,4);
+        for(int narrow=0;narrow<5;++narrow)if(live&&live<=kNarrowAttentionRows[narrow]){if(r->compact_exec[2+narrow])selected_exec=r->compact_exec[2+narrow];break;}
+      }
     }
   }
   if(r->decode_capacity!=0){
@@ -1311,8 +1319,10 @@ static RileyCudaStatus record_variable_shared(
     if(status==RILEY_CUDA_STATUS_SUCCESS){r->compact_graph[stage]=r->graph;r->compact_exec[stage]=r->exec;r->graph=nullptr;r->exec=nullptr;}
    }
    if constexpr(Mixed){
-    if(status==RILEY_CUDA_STATUS_SUCCESS)status=record_shape(1,true,1);
-    if(status==RILEY_CUDA_STATUS_SUCCESS){r->compact_graph[2]=r->graph;r->compact_exec[2]=r->exec;r->graph=nullptr;r->exec=nullptr;}
+    for(int narrow=0;narrow<5&&status==RILEY_CUDA_STATUS_SUCCESS;++narrow){
+     status=record_shape(1,true,kNarrowAttentionRows[narrow]);
+     if(status==RILEY_CUDA_STATUS_SUCCESS){r->compact_graph[2+narrow]=r->graph;r->compact_exec[2+narrow]=r->exec;r->graph=nullptr;r->exec=nullptr;}
+    }
    }
   }
   if(status==RILEY_CUDA_STATUS_SUCCESS)status=record_shape(1);
diff --git a/kernels/tests/kernel_batch14_correctness.cu b/kernels/tests/kernel_batch14_correctness.cu
index ea74e308..0e1e87f4 100644
--- a/kernels/tests/kernel_batch14_correctness.cu
+++ b/kernels/tests/kernel_batch14_correctness.cu
@@ -1,4 +1,4 @@
-// Batch14: one-live-row attention launch grids; exact against the capacity grids, including guards and inactive rows.
+// Batch14: narrow attention launch grids for at most 1, 2, 4, 8 and 16 live rows; exact against the capacity grids, including guards and inactive rows.
 #define RILEY_BATCH11_MAIN kernel_batch11_matrix_main
 #include "kernel_batch11_correctness.cu"
 #include <algorithm>
@@ -13,18 +13,18 @@ int narrow_attention_cases(int seed){
  int cases=0;
  for(int count:{1,7,8,9,15,16,17,63,64,65,127,128,129,255,256,257,1023,1024,4095,4096}){
   for(int r=0;r<32;++r){shape[r*416+1]=count-1;for(int p=0;p<256;++p)pages[r*416+p]=(p*5+13+r)%256;}
-  for(uint32_t context:{1u,8u,9u,160u,1024u,4096u})for(int rows:{0,1}){
+  for(uint32_t context:{1u,9u,160u,4096u})for(uint32_t grid_rows:{1u,2u,4u,8u,16u})for(int rows:{0,1,int(grid_rows/2+1),int(grid_rows)}){
    const uint32_t stripes=std::min((context+7)/8,32u);
    *live=rows;fill_fp32(sa,S+2*Guard);fill_fp32(sb,S+2*Guard);fill_bf16(a,N+2*Guard);fill_bf16(b,N+2*Guard);
    riley_gqa50_attention_batch11_reference::scores<<<dim3(stripes,96),32>>>(q,k,sa+Guard,shape,pages,live);
    riley_gqa50_attention_batch11_reference::independent_values<<<dim3(8,96),96>>>(sa+Guard,v,a+Guard,shape,pages,live);
-   riley_gqa50_attention::enqueue(nullptr,q,k,v,b+Guard,sb+Guard,shape,pages,live,context,1);
+   riley_gqa50_attention::enqueue(nullptr,q,k,v,b+Guard,sb+Guard,shape,pages,live,context,grid_rows);
    OK(cudaGetLastError());OK(cudaDeviceSynchronize());
-   compare(sa,sb,S+2*Guard,"one-row grid QK scores including guards/inactive",rows);
-   compare(a,b,N+2*Guard,"one-row grid AV including guards/inactive",rows);
+   compare(sa,sb,S+2*Guard,"narrow grid QK scores including guards/inactive",rows);
+   compare(a,b,N+2*Guard,"narrow grid AV including guards/inactive",rows);
    ++cases;
   }
  }
  for(void* p:{(void*)q,(void*)k,(void*)v,(void*)sa,(void*)sb,(void*)a,(void*)b,(void*)shape,(void*)pages,(void*)live})OK(cudaFree(p));return cases;
 }
-int main(){kernel_batch11_matrix_main();int narrow=0;for(int seed:{1,17,99})narrow+=narrow_attention_cases(seed);OK(cudaDeviceSynchronize());std::printf("{\"passed\":true,\"one_row_grid_attention_cases\":%d,\"BF16_and_FP32_exact\":true,\"performance_claim_eligible\":false}\n",narrow);}
+int main(){kernel_batch11_matrix_main();int narrow=0;for(int seed:{1,17,99})narrow+=narrow_attention_cases(seed);OK(cudaDeviceSynchronize());std::printf("{\"passed\":true,\"narrow_grid_attention_cases\":%d,\"BF16_and_FP32_exact\":true,\"performance_claim_eligible\":false}\n",narrow);}
