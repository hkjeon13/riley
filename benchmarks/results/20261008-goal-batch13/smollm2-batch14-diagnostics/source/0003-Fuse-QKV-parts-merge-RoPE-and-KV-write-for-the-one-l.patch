 3 files changed, 68 insertions(+), 4 deletions(-)

diff --git a/kernels/src/decode_shared32_model.cuh b/kernels/src/decode_shared32_model.cuh
index 169e003c..a836b02f 100644
--- a/kernels/src/decode_shared32_model.cuh
