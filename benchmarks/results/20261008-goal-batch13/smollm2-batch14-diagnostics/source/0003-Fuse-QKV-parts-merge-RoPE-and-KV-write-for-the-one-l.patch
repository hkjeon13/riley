+#include "decode_shared32_model.cuh"
+int fused_qkv_cases(int seed){
+ constexpr int Physical=256,KV=Physical*3*16*64,Guard=16,Parts=3*32*(576+192+192);
+ auto* x=alloc<__nv_bfloat16>(32*576);auto* qw=alloc<__nv_bfloat16>(576*576);auto* kw=alloc<__nv_bfloat16>(192*576);auto* vw=alloc<__nv_bfloat16>(192*576);
+ auto* pa=alloc<float>(Parts);auto* pb=alloc<float>(Parts);
+ auto* qa=alloc<__nv_bfloat16>(32*576+2*Guard);auto* qb=alloc<__nv_bfloat16>(32*576+2*Guard);
+ auto* ka=alloc<__nv_bfloat16>(KV+2*Guard);auto* kb=alloc<__nv_bfloat16>(KV+2*Guard);auto* va=alloc<__nv_bfloat16>(KV+2*Guard);auto* vb=alloc<__nv_bfloat16>(KV+2*Guard);
+ auto* cos=alloc<float>(4096*32);auto* sin=alloc<float>(4096*32);
+ auto* shape=alloc<uint32_t>(32*416);auto* pages=alloc<uint32_t>(32*416);auto* live=alloc<uint32_t>(1);
+ for(int i=0;i<32*576;++i)x[i]=__float2bfloat16_rn(float((i*17+seed)%127-63)/128);
+ for(int i=0;i<576*576;++i)qw[i]=__float2bfloat16_rn(float((i*7+seed)%131-65)/128);
+ for(int i=0;i<192*576;++i){kw[i]=__float2bfloat16_rn(float((i*11+seed)%113-56)/128);vw[i]=__float2bfloat16_rn(float((i*13+seed)%251-125)/128);}
+ for(int i=0;i<4096*32;++i){cos[i]=std::cos(float(i%977)*.0131F+seed);sin[i]=std::sin(float(i%977)*.0131F+seed);}
+ if(seed==99)for(int i=0;i<576;++i)x[i]=__float2bfloat16_rn(i%2?3.0e38F:-3.0e38F);
+ int cases=0;
+ for(int position:{0,1,15,16,17,127,128,1023,4095}){
+  // Distinct physical pages per row so no two rows write the same cache slot.
+  for(int r=0;r<32;++r){shape[r*416+1]=position;for(int p=0;p<256;++p)pages[r*416+p]=(p*7+r*8)%Physical;}
+  for(int rows:{0,1,2,3,15,16,17,31,32,33}){
+   *live=rows;fill_fp32(pa,Parts);fill_fp32(pb,Parts);fill_bf16(qa,32*576+2*Guard);fill_bf16(qb,32*576+2*Guard);
+   fill_bf16(ka,KV+2*Guard);fill_bf16(kb,KV+2*Guard);fill_bf16(va,KV+2*Guard);fill_bf16(vb,KV+2*Guard);
+   shared32_qkv_parts<<<dim3(120,3),32>>>(x,qw,kw,vw,pa,live);
+   riley_shared32_model::qkv_merge_rope<<<dim3(2,32),256>>>(pa,qa+Guard,ka+Guard,va+Guard,cos,sin,pages,shape,live);
+   riley_shared32_model::qkv_parts_merge_rope<<<60,192>>>(x,qw,kw,vw,pb,qb+Guard,kb+Guard,vb+Guard,cos,sin,pages,shape,live);
+   OK(cudaGetLastError());OK(cudaDeviceSynchronize());
+   compare(pa,pb,Parts,"fused QKV FP32 parts including inactive",rows);
+   compare(qa,qb,32*576+2*Guard,"fused QKV rotated query including guards/inactive",rows);
+   compare(ka,kb,KV+2*Guard,"fused QKV cache keys including guards/untouched",rows);
+   compare(va,vb,KV+2*Guard,"fused QKV cache values including guards/untouched",rows);
