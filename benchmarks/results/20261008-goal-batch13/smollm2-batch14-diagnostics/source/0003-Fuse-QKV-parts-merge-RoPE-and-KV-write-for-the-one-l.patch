@@ -46,12 +46,39 @@ __global__ void qkv_merge_rope(const float* parts,__nv_bfloat16* qo,__nv_bfloat1
  if(head<9){qo[row*576+base+dim]=first;qo[row*576+base+dim+32]=second;}
  else {uint32_t dst=((pages[pos/16]*3+head-9)*16+pos%16)*64+dim;keys[dst]=first;keys[dst+32]=second;const float* v=parts+3*32*(576+192);values[dst]=qkv_rounded(v,192,row,base+dim);values[dst+32]=qkv_rounded(v,192,row,base+dim+32);}
 }
+// QKV parts, merge, RoPE and KV write in one dispatch. A block owns the two
+// eight-column tiles that RoPE pairs (dim and dim+32 of one head): six warps
+// run the unchanged K192 chunk recurrences for those tiles into the FP32 parts
+// buffer, then the block merges and rotates its own columns exactly as
+// qkv_merge_rope does. Blocks 0..35 are Q, 36..47 K, 48..59 V.
+__global__ void qkv_parts_merge_rope(const __nv_bfloat16* x,const __nv_bfloat16* qw,const __nv_bfloat16* kw,const __nv_bfloat16* vw,float* parts,__nv_bfloat16* qo,__nv_bfloat16* keys,__nv_bfloat16* values,const float* cos,const float* sin,const uint32_t* pages,const uint32_t* shape,const uint32_t* active){
+ const uint32_t rows=*active;if(rows<1||rows>32)return;
+ const int block=blockIdx.x,kind=block<36?0:(block<48?1:2),local=block-(kind==0?0:(kind==1?36:48)),head=local/4,pair=local%4;
+ const int warp=threadIdx.x/32,column=head*8+pair+(warp/3)*4,chunk=warp%3;
+ float* part=kind==0?parts:parts+3*32*576+(kind==1?0:3*32*192);
+ if(kind==0)shared32_projection_compute<576,576,192,false>(x,qw,part,nullptr,active,column,chunk);
+ else shared32_projection_compute<192,576,192,false>(x,kind==1?kw:vw,part,nullptr,active,column,chunk);
+ __syncthreads();
+ const int n=kind==0?576:192,base=head*64;
+ for(uint32_t i=threadIdx.x;i<rows*8;i+=blockDim.x){
+  const uint32_t row=i/8;const int dim=pair*8+int(i%8);
+  const uint32_t* row_shape=shape+row*416;const uint32_t* row_pages=pages+row*416;const uint32_t pos=row_shape[1];
+  const __nv_bfloat16 low=qkv_rounded(part,n,row,base+dim),high=qkv_rounded(part,n,row,base+dim+32);
+  const uint32_t dst=((row_pages[pos/16]*3+head)*16+pos%16)*64+dim;
+  if(kind==2){values[dst]=low;values[dst+32]=high;continue;}
+  float a=__bfloat162float(low),b=__bfloat162float(high);
+  float c=__bfloat162float(__float2bfloat16_rn(cos[pos*32+dim])),sn=__bfloat162float(__float2bfloat16_rn(sin[pos*32+dim]));
+  auto first=__float2bfloat16_rn(a*c-b*sn),second=__float2bfloat16_rn(b*c+a*sn);
+  if(kind==0){qo[row*576+base+dim]=first;qo[row*576+base+dim+32]=second;}
+  else{keys[dst]=first;keys[dst+32]=second;}
+ }
+}
 // Fixed-capacity GEMM also reads inactive rows; initialize those inputs.
 __global__ void clear_inactive_hidden(__nv_bfloat16* hidden,const uint32_t* active){
  uint32_t rows=*active,row=blockIdx.x;if(rows<1||rows>32||row<rows)return;
  for(uint32_t i=threadIdx.x;i<576;i+=blockDim.x)hidden[row*576+i]=__float2bfloat16_rn(0.F);
 }
