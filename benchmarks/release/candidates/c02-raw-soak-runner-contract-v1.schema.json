{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://riley.invalid/benchmarks/release/candidates/c02-raw-soak-runner-contract-v1.schema.json",
  "title": "Riley C02 serial raw-soak runner contract v1",
  "description": "Closed canonical input for the initial host-binary C02-P1 raw scenario producer. It permits only one non-streaming completion per serial scenario on one already-bound process identity. It is raw capture only, never a semantic soak verdict or a request to operate Docker, SSH, or a GPU by itself.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "candidate_id", "configuration_profile", "scenarios"],
  "properties": {
    "schema_version": {"const": "riley.c02-raw-soak-runner-contract.v1"},
    "candidate_id": {"$ref": "#/$defs/candidateId"},
    "configuration_profile": {"enum": ["stable-default", "max-performance-exact"]},
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {"$ref": "#/$defs/scenario"}
    }
  },
  "$defs": {
    "candidateId": {
      "type": "string",
      "pattern": "^riley-(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)-rc[1-9][0-9]*$"
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenario_id", "completion_request"],
      "properties": {
        "scenario_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^(?!exact-backend-fallback$)[a-z0-9][a-z0-9-]*$",
          "description": "The fallback scenario is excluded until source emits a second distinct native fallback-event leaf; generation-audit-v2 is already reserved as the runtime-event leaf."
        },
        "completion_request": {"$ref": "#/$defs/completionRequest"}
      }
    },
    "completionRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "prompt", "max_tokens", "temperature", "top_p", "seed", "stream"],
      "properties": {
        "model": {"type": "string", "minLength": 1, "maxLength": 256},
        "prompt": {"type": "string", "minLength": 1, "maxLength": 1048576},
        "max_tokens": {"type": "integer", "minimum": 1, "maximum": 65536},
        "temperature": {"type": "number", "minimum": 0, "maximum": 2},
        "top_p": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "seed": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
        "stream": {"const": false}
      }
    }
  }
}
